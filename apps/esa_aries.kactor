		button("EUNIS (Machine Learning)"): website_eunis_ml
	):hidden #eu_computation_links
	
		
	action activate_noneu: (
		noneu_obs.show
		noneu_computation_links.show
	)
	action activate_eu: (
		eu_obs.show
		eu_computation_links.show
	)

	action disable_ctxs(context_name, context_label): (
		contexts.hide
		reset_context.enable
		header_label.update([context_label])
		headers.show
		computation_links.show
		context([context_name])
		queries.show
	)

	action reset_buttons: (
		headers.hide
		queries.hide
		context(:reset)
		reset(:wait)
	)
	
@modal(width=1100, height=650, title="EUNIS (Machine Learning)")
action website_eunis_ml:
	html("https://esa-weed-project.github.io/openeo_jobdb_viewer/#url=https%3A%2F%2Fcatalogue.weed.apex.esa.int%2Fcollections%2FMachineLearning-EUNIS2021plus-PROBA-V320-jobdb&refreshIntervalSeconds=30")
@modal(width=1100, height=650, title="IUCN GET (Machine Learning)")
action website_iucnget_ml:
	html("https://esa-weed-project.github.io/openeo_jobdb_viewer/#url=https%3A%2F%2Fcatalogue.weed.apex.esa.int%2Fcollections%2FMachineLearning-IUCNGET-PROBA-V330-jobdb&refreshIntervalSeconds=30")
@modal(width=1100, height=650, title="IUCN GET (Rule-based)")
action website_iucnget_rb:
	html("https://esa-weed-project.github.io/openeo_jobdb_viewer/#url=https%3A%2F%2Fcatalogue.weed.apex.esa.int%2Fcollections%2FRuleBased-EXTENT-V502-jobdb&refreshIntervalSeconds=30")