				(
					checkbutton("Machine Learning (IUCN GET) results" #noneu_mlr :tooltip "Machine Learning (IUCN GET) results"): (
						submit(esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_machine_learning)
					)
					checkbutton("Machine Learning (IUCN GET) summary table" #noneu_mlst :tooltip "Machine Learning (IUCN GET) summary table"): (
						submit(esa.aries.ecosystem_extent_table.ecosystem_typology_extent_iucn_machine_learning_static)				
					)					
					checkbutton("Rule-based (IUCN GET) results" #noneu_rbigr :tooltip "Rule-based (IUCN GET) results"): (
						submit(esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_rule_based) :
						submit(esa.aries.ecosystem_extent.ecosystem_characteristics)
					)
					checkbutton("Rule-based (IUCN GET) summary table" #noneu_rbigst :tooltip "Rule-based (IUCN GET) summary table"): (
						submit(esa.aries.ecosystem_extent_table.ecosystem_typology_extent_iucn_get_rule_based_basic)				
					)
					checkbutton("Hybrid modelling" #noneu_hm :tooltip "Hybrid modelling" :disabled)
					checkbutton("Headline Indicator A.2 KMGBF - Extent of Natural Ecosystem from Machine Learning (IUCN GET) results" #noneu_a2mlr :tooltip "Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF)"): (
						submit(esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_machine_learning)
						submit(esa.aries.ecosystem_extent_table.natural_ecosystem_extent_iucn_get_machine_learning_net_change)
					)
					checkbutton("Headline Indicator A.2 KMGBF - Extent of Natural Ecosystem from Rule-based (IUCN GET) results" #noneu_a2rbr :tooltip "Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF)"): (
						 submit(esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_rule_based) 
						 submit(esa.aries.ecosystem_extent_table.natural_ecosystem_extent_iucn_get_rule_based_net_change)
					)						
				) :hidden #noneu_obs								
				(
					checkbutton("Machine Learning (EUNIS classification) results" #eu_mlr :tooltip "Machine Learning (EUNIS classification) results"): (
						submit(esa.aries.ecosystem_extent.ecosystem_type_eunis_level2_machine_learning)
					)
					checkbutton("Machine Learning (EUNIS classification) summary table" #eu_mlst :tooltip "Machine Learning (EUNIS classification) summary table"): (
						submit(esa.aries.ecosystem_extent_table.ecosystem_typology_extent_eunis_machine_learning_static)				
					)						
					checkbutton("Rule-based (IUCN GET) results" #eu_rbigr :tooltip "Rule-based (IUCN GET) results" :disabled): (
						submit(esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_rule_based):
						submit(esa.aries.ecosystem_extent.ecosystem_characteristics)
					)
					checkbutton("Rule-based (IUCN GET) summary table" #eu_rbigst :tooltip "Rule-based (IUCN GET) summary table" :disabled): (
						submit(esa.aries.ecosystem_extent_table.ecosystem_typology_extent_iucn_get_rule_based_static)				
					)					
					checkbutton("Hybrid modelling" #eu_hm :tooltip "Hybrid modelling" :disabled)
					checkbutton("Headline Indicator A.2 KMGBF - Extent of Natural Ecosystem from Machine Learning (EUNIS) results" #ey_a2mlr :tooltip "Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF)":disabled 
						submit(esa.aries.ecosystem.naturalness.eunis_natural_ecosystem_extent)
						submit(esa.aries.ecosystem.naturalness.natural_ecosystem_extent_eunis)
					)
					checkbutton("Headline Indicator A.2 KMGBF - Extent of Natural Ecosystem from Rule-based (IUCN GET) results" #eu_a2rbr :tooltip "Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF)"): (
						submit(esa.aries.ecosystem.naturalness.natural_ecosystem_extent_iucn_get_rule_based)
						submit(esa.aries.ecosystem.naturalness.gbf_indicator_a2_natural_ecosystem_percentage_iucn_get_rule_based_static) 
					)
					checkbutton("Headline Indicator A.2 KMGBF - Extent of Natural Ecosystem from Machine Learning (IUCN GET) results" #eu_a2rbr :tooltip "Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF)"): (
						submit(esa.aries.ecosystem.naturalness.natural_ecosystem_extent_iucn_get_machine_learning)
						submit(esa.aries.ecosystem.naturalness.gbf_indicator_a2_natural_ecosystem_percentage_iucn_get__machine_learning_static) 
					)					
					hybrid.disable					
				) :hidden #eu_obs
			)
	) :hidden #queries
	
	(
			label(context_label width="100%" :info #header_label)
			button(:tooltip "Interrupt computation and reset context" #breset :iconname "close-circle-outline" 
					color="red-8"
				): reset_buttons
	) :hbox :hidden #headers
	
		
	action activate_noneu: (
		noneu_obs.show
	)
	action activate_eu: (
		eu_obs.show
	)

	action disable_ctxs(context_name, context_label): (
		contexts.hide
		reset_context.enable
		header_label.update([context_label])
		headers.show
		context([context_name])
		queries.show
	)
	action reset_buttons: (
		headers.hide
		queries.hide
		context(:reset)
		reset(:wait)
	)