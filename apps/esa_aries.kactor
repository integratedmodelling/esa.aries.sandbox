	(
		(
			label(context_label width="100%" :info #header_label)
			button(:tooltip "Interrupt computation and reset context" #breset :iconname "close-circle-outline" 
					color="red-8"
				): reset_buttons
		) :hbox :hidden #headers
			
	)

	(
		(
			separator("Query Ecosystem Types according to:" :iconname "sprout-outline" )
			(
				(
//					checkbutton("Machine Learning results (IUCN GET classification)" #colombia_obs_ml): (
//						submit(ml.ecosystem_type.inference.ecdc_level3_mece)
//					)
					checkbutton("Rule-based results (Local classification)" #colombia_obs_local :tooltip "Rule-based results (Local classification)"): (
						submit(rule_based_modelling.colombia.ecosystem_type_colombia_new)
					)
					checkbutton("Rule-based results (IUCN GET classification)" #colombia_obs_iucnget :tooltip "Rule-based results (IUCN GET classification)"): (
						submit(rule_based_modelling.colombia.ecosystem_type_iucn_get_new)
					)
				) :hidden #colombia_obs
				(
//					checkbutton("Machine Learning results (IUCN GET classification)" #southafrica_obs_ml): (
//						submit(ml.ecosystem_type.inference.ecdc_level3_mece)
//					)
					checkbutton("Rule-based results (IUCN GET classification)" #southafrica_iucnget :tooltip "Rule-based results (IUCN GET classification)" ): (
						submit(rule_based_modelling.south_africa.ecosystem_type_iucn_get_improved)
					)
				) :hidden #southafrica_obs
				(
//					checkbutton("Machine Learning results (IUCN GET classification)" #vietnam_obs_ml): (
//						submit(ml.ecosystem_type.inference.ecdc_level3_mece)
//					) 
					checkbutton("Rule-based results (IUCN GET classification)" #vietnam_obs_2 :tooltip "Rule-based results (IUCN GET classification)"): (
						submit(rule_based_modelling.vietnam.ecosystem_type_iucn_get_improved)
					)			
				) :hidden #vietnam_obs
				(
					checkbutton("Machine Learning results (EUNIS Typology)" #europe_obs_1 :tooltip "Machine Learning results (EUNIS Typology)"): (
						submit(ml.ecosystem_type.inference.ml_inferences)
					) 
					
					checkbutton("Machine Learning Inference Calculated Extent" #europe_obs_2 :tooltip "Machine Learning Inference Calculated Extent"): (
						submit(ml.ecosystem_type.inference.ml_inference_presence)
					)
				) :hidden #europe_obs
			)
		) :hidden #queries	
	)
 	
	action activate_europe: (
		europe_obs.show
	)
	
	action activate_colombia: (
		colombia_obs.show
	)

	action activate_southafrica: (
		southafrica_obs.show
	)
		
	action activate_vietnam: (
		vietnam_obs.show
	)
	
	action disable_ctxs(context_name, context_label): (
		contexts.hide
		reset_context.enable
		header_label.update([context_label])
		headers.show
		context([context_name])
		queries.show
	)
	action reset_buttons: (
		headers.hide
		queries.hide
		context(:reset)
		reset(:wait)
	)