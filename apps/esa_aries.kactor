public app esa.aries
	"ARIES for ESA"
	version 1.0alpha
	description #ARIES_FOR_ESA_EXPLORER_DESCRIPTION
	logo static/images/esa_logo_deepspace.png
	versionstring "Demonstration version (Beta)"
	style light


@left(width=450)
action main:
