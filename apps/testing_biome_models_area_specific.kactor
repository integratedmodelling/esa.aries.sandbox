set country_urns (
	"local:rubencc:esa.aries.sandbox:esa_weed_greece_rb_testing_polygons"
	"local:rubencc:esa.aries.sandbox:esa_weed_colombia_rb_testing_polygons"
	"local:rubencc:esa.aries.sandbox:esa_weed_southafrica_rb_testing_polygons"
	"local:rubencc:esa.aries.sandbox:esa_weed_vietnam_rb_testing_polygons"
	"local:rubencc:esa.aries.sandbox:esa_weed_norway_rb_testing_polygons"
	"local:rubencc:esa.aries.sandbox:esa_weed_czechrepublic_rb_testing_polygons"
)

resolution=30.m

for year in (2021) (
	for country_urn in country_urns (
		
		set urn_string [country_urn.toString()]
		set current_country "unknown"
		
        // FLAT IF STATEMENTS FOR COUNTRY
		if [urn_string.contains("greece")] ( set current_country "GRC" )
		if [urn_string.contains("colombia")] ( set current_country "COL" )
		if [urn_string.contains("southafrica")] ( set current_country "ZAF" )
		if [urn_string.contains("vietnam")] ( set current_country "VNM" )
		if [urn_string.contains("norway")] ( set current_country "NOR" )
		if [urn_string.contains("czechrepublic")] ( set current_country "CZE" )

		for polygon in country_urn (
            
            set current_fid [polygon.fid_id.toString()]
            set current_observables ()
            
            // FLAT IF STATEMENTS FOR AREA
            if [current_country == "COL" && current_fid == "1"] ( set current_observables colombia_testing_area_1 )
            if [current_country == "COL" && current_fid == "2"] ( set current_observables colombia_testing_area_2 )
            if [current_country == "COL" && current_fid == "3"] ( set current_observables colombia_testing_area_3 )
            if [current_country == "COL" && current_fid == "4"] ( set current_observables colombia_testing_area_4 )
            if [current_country == "COL" && current_fid == "5"] ( set current_observables colombia_testing_area_5 )
            if [current_country == "CZE" && current_fid == "1"] ( set current_observables czechrepublic_testing_area_1 )
            if [current_country == "CZE" && current_fid == "2"] ( set current_observables czechrepublic_testing_area_2 )
            if [current_country == "CZE" && current_fid == "3"] ( set current_observables czechrepublic_testing_area_3 )
            if [current_country == "CZE" && current_fid == "4"] ( set current_observables czechrepublic_testing_area_4 )
            if [current_country == "GRC" && current_fid == "1"] ( set current_observables greece_testing_area_1 )
            if [current_country == "GRC" && current_fid == "2"] ( set current_observables greece_testing_area_2 )
            if [current_country == "GRC" && current_fid == "3"] ( set current_observables greece_testing_area_3 )
            if [current_country == "GRC" && current_fid == "4"] ( set current_observables greece_testing_area_4 )
            if [current_country == "NOR" && current_fid == "1"] ( set current_observables norway_testing_area_1 )
            if [current_country == "NOR" && current_fid == "2"] ( set current_observables norway_testing_area_2 )
            if [current_country == "NOR" && current_fid == "3"] ( set current_observables norway_testing_area_3 )
            if [current_country == "NOR" && current_fid == "4"] ( set current_observables norway_testing_area_4 )
            if [current_country == "NOR" && current_fid == "5"] ( set current_observables norway_testing_area_5 )
            if [current_country == "ZAF" && current_fid == "1"] ( set current_observables southafrica_testing_area_1 )
            if [current_country == "ZAF" && current_fid == "2"] ( set current_observables southafrica_testing_area_2 )
            if [current_country == "ZAF" && current_fid == "3"] ( set current_observables southafrica_testing_area_3 )
            if [current_country == "ZAF" && current_fid == "4"] ( set current_observables southafrica_testing_area_4 )
            if [current_country == "VNM" && current_fid == "1"] ( set current_observables vietnam_testing_area_1 )
            if [current_country == "VNM" && current_fid == "2"] ( set current_observables vietnam_testing_area_2 )
            if [current_country == "VNM" && current_fid == "3"] ( set current_observables vietnam_testing_area_3 )
            if [current_country == "VNM" && current_fid == "4"] ( set current_observables vietnam_testing_area_4 )

            if [!current_observables.isEmpty()] (
				
                context(polygon,resolution,Time(year=year))
					
                for urn in current_observables (
					submit(urn): (
						WAITING -> ()
						STARTED -> ()
						ABORTED -> warning("Aborted")
						INTERRUPTED -> warning("Interrupted")
						empty -> (
						    alert("The computation did not produce results. Some needed resources may be offline, or the system may be overloaded.")
						    error(["Empty observation: " + urn.toString()])
						)
					    observation -> (
						    set urn_name ""
						    if [urn.toString().startsWith("[")] (
							    set urn_name [urn.name]
						    ) else (
							    set urn_name urn
						    )
						    if [observation.isEmpty()] (
							    warning(["Observation " + urn_name + " is empty"])
						    ) else (
							    observation.export([output_folder_directory + "/" + year + "/" + current_country + "/Area_" + polygon.fid_id + "/" + current_country + "_" + polygon.fid_id + "__" + urn_name + "__" + year + ".tiff"])						
							    info(["Exporting urn " + urn_name + " for " + current_country + " Area " + polygon.fid_id])
							)
						)
					)
				)
            )
		)
	)	
)
