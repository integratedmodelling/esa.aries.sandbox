private namespace cu_priority_areas_contexts;

//WEED SITE : SA1
//NAME : Cape Point
observe earth:Region named south_africa_sa1_cape_town_2022
over space(shape='MULTIPOLYGON (((18.36897465393701268 -34.20261296475762691, 18.43909811721211156 -34.18348838386441457, 18.45461027726993564 -34.19793806720595342, 18.4716099047305633 -34.22471248045643932, 18.48202217655019908 -34.23278730350023835, 18.48393463463952102 -34.2582867446911834, 18.46990994198450053 -34.26657406307824516, 18.47798476502829956 -34.27826130695742535, 18.46459755840305661 -34.3116230758489138, 18.46927245595473011 -34.3171479547736169, 18.46523504443283059 -34.32012288957922408, 18.47415984884965923 -34.33860998444266244, 18.50412169224902215 -34.35093471435161661, 18.50539666430857011 -34.36665936975270341, 18.47139740938730768 -34.36538439769315545, 18.43527320103346767 -34.34285989130781758, 18.39532407650098378 -34.31906041286293174, 18.3715245980561015 -34.27443639077877435, 18.36576066187023315 -34.20327701270528564, 18.36841353342121153 -34.20272917314844818, 18.36841353342121153 -34.20272917314844818, 18.36897465393701268 -34.20261296475762691)))',
grid="30 m",
projection="EPSG:4326"),
time(start=2024, end=2025, step=1.year);

