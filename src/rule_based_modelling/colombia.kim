//@documented(colombia.ecosystemextent.ecosystemtype)
//model type of aries.colombia.ecosystem:ModelledColombianEcosystem named ecosystem_type_colombia
//	observing
//		   colombia.seea.landcover:ColombianLandCoverType named landcover,
//		   type of colombia.seea.ecology:ClimateRegion named climate_region,
//		   type of colombia.seea.ecology:Biome named prel_biome,
//		   type of colombia.seea.ecology:BioticUnit named biotic_unit,
//		   soil_edafogenetic_environment,
//		   type of colombia.seea.hydrology:RiverWater named water_type,
//		   type of colombia.seea.ecology:Transformation named transformed,		   
//		   type of colombia.seea.hydrology:AquaticEnvironment named transitional,		   		   
//		   non_continental
//	lookup(landcover,climate_region, prel_biome, biotic_unit, soil_edafogenetic_environment,  water_type, transformed, transitional, non_continental, ?, *) into MODELLED_GET_EFG_COLOMBIA;
//	
//@documented(colombia.ecosystemextent.ecosystemtype) 
//model nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get 
//	observing
//		   colombia.seea.landcover:ColombianLandCoverType named landcover,
//		   type of colombia.seea.ecology:ClimateRegion named climate_region,
//		   type of colombia.seea.ecology:Biome named prel_biome,
//		   type of colombia.seea.ecology:BioticUnit named biotic_unit,
//		   soil_edafogenetic_environment,
//		   type of colombia.seea.hydrology:RiverWater named water_type,
//		   type of colombia.seea.ecology:Transformation named transformed,		   
//		   type of colombia.seea.hydrology:AquaticEnvironment named transitional,		   		   
//		   non_continental
//	lookup(landcover,climate_region, prel_biome, biotic_unit, soil_edafogenetic_environment,  water_type, transformed, transitional, non_continental, *, ?) into MODELLED_GET_EFG_COLOMBIA;






//--- TypeRbNew annotation ---
//model nca.ecosystem.iucn:TypeRbNew type of nca.ecosystem.iucn:Ecosystem named ecosystem_type_rb_new
@documented(colombia.ecosystemextent.ecosystemtype)
model type of aries.colombia.ecosystem:ModelledColombianEcosystem named ecosystem_type_colombia_new
observing
    type of colombia.seea.ecology:Biome named biome_type,
    type of colombia.seea.ecology:BioticUnit named biotic_unit_type,
    type of colombia.seea.ecology:ClimateRegion named climate_region,
    type of colombia.seea.ecology:Transformation named transformation_type,
    soil_edafogenetic_environment,
    type of colombia.seea.hydrology:RiverWater named river_water_type,
    type of colombia.seea.hydrology:AquaticEnvironment named transitionality,
    wetlands,
    non_continental 
lookup (biome_type, biotic_unit_type, climate_region, transformation_type, soil_edafogenetic_environment, river_water_type, transitionality, wetlands, non_continental, ?, *) into NEW_COLOMBIA_WITH_IUCN;

@documented(colombia.ecosystemextent.ecosystemtype) 
model nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get_new 
observing
    type of colombia.seea.ecology:Biome named biome_type,
    type of colombia.seea.ecology:BioticUnit named biotic_unit_type,
    type of colombia.seea.ecology:ClimateRegion named climate_region,
    type of colombia.seea.ecology:Transformation named transformation_type,
    soil_edafogenetic_environment,
    type of colombia.seea.hydrology:RiverWater named river_water_type,
    type of colombia.seea.hydrology:AquaticEnvironment named transitionality,
    wetlands,
    non_continental 
lookup (biome_type, biotic_unit_type, climate_region, transformation_type, soil_edafogenetic_environment, river_water_type, transitionality, wetlands, non_continental, *, ?) into NEW_COLOMBIA_WITH_IUCN;


