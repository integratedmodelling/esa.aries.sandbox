				nca.ecosystem.iucn:BoulderCobbleShore if 90104,
			nca.ecosystem.iucn:SupralittoralCoastal if 90200,
				nca.ecosystem.iucn:CoastalShrublandGrassland if 90201,
			nca.ecosystem.iucn:AnthropogenicShoreline if 90300,
				nca.ecosystem.iucn:ArtificialShoreline if 90301,
		nca.ecosystem.iucn:SubterraneanFreshwater if 30000,
			nca.ecosystem.iucn:SubterraneanFreshwaterBiome if 30100,
				nca.ecosystem.iucn:UndergroundStreamPool if 30101,
				nca.ecosystem.iucn:Groundwater if 30102,
			nca.ecosystem.iucn:AnthropogenicSubterraneanFreshwater if 30200,
				nca.ecosystem.iucn:WaterPipeSubterraneanCanal if 30201,
				nca.ecosystem.iucn:FloodedMine if 30202,
		nca.ecosystem.iucn:SubterraneanMarine if 40000,
			nca.ecosystem.iucn:SubterraneanTidal if 40100,
				nca.ecosystem.iucn:AnchialineCaves if 40101,
				nca.ecosystem.iucn:AnchialinePools if 40102,
				nca.ecosystem.iucn:SeaCaves if 40103,
		nca.ecosystem.iucn:TerrestrialFreshwater if 50000,
			nca.ecosystem.iucn:PalustrineWetland if 50100,
				nca.ecosystem.iucn:TropicalFloodedForestPeatForest if 50101,
				nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland if 50102,
				nca.ecosystem.iucn:PermanentMarsh if 50103,
				nca.ecosystem.iucn:SeasonalFloodplainMarsh if 50104,
				nca.ecosystem.iucn:EpisodicAridFloodplain if 50105,
				nca.ecosystem.iucn:BorealCoolTemperatePalustrineWetland if 50106,
				nca.ecosystem.iucn:BorealTemperateMontanePeatBog if 50107;
  
  
@colormap(values = {
	true:	(0 255 0)
	false:	(255 0 0)	
})
model presence of (earth:Region with type of nca.ecosystem.iucn:Ecosystem) named matching_ecosystem_type
	observing
		geography:Colombia im:Reference nca.ecosystem.iucn:EcosystemType named colombia_reference_ecosystem_type,
		nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get_level3_rule_based
			lookup (ecosystem_type_iucn_get_level3_rule_based, colombia_reference_ecosystem_type, *, *, ?, *) 
		into IUCN_GET_LEVEL_CONSISTENCY_TABLE;
			