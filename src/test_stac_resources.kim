private namespace test_stac_resources
using nca.ecosystem.iucn, esa.aries.model_approach;

/*IUCN GET Machine Learning */
model 'local:alessio.bulckaen:esa.aries.sandbox:ML-IUCNGET-V330-MECE' 
as esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
classified according to im:ecosystem-get-iucn;

observe earth:Region named colombia_iucnget_v330_mece_ee63ed23_67a9_4e6f_9fdc_2296feb6087a_2024_01_01t00_00_00z
        over space(shape='EPSG:4326 POLYGON ((-74.63639090920245 8.684582887631175, -74.63621481141978 8.86548320687615, -74.81810646146585 8.86561597006672, -74.8181945125877 8.68471290106149, -74.63639090920245 8.684582887631175))',
                grid = "30 m"),
        time (year=2024);
        
