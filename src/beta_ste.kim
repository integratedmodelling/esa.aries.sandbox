private namespace beta_ste
using nca.ecosystem.iucn, nca.ecology.ipcc,
primitive_characteristic.climate; //FLAG local concept 

define BIOME_F1_RIVER_STREAM_ECOSYSTEM_TYPES as {{
    waterbody_type        | watershed_hierarchy | water_permanence_type | altitude_zone
    | climate_zone
    | evapotranspiration
    | ecosystem_type
    ---------------------------------------------------------------------------------------------------------------------------------

    // ============================================================
    // SPECIFIC HARD-RULE APPROXIMATIONS
    // ============================================================

    // F1.7 — before the broader permanent-lowland rows.
    hydrology:Watercourse | im:High
        | hydrology:Permanent
        | earth:Lowland
        | #
        | in (ecology:Humid, ecology:SubHumid, ecology:Wet)
        | nca.ecosystem.iucn:LargeLowlandRiver ,

    // F1.5
    hydrology:Watercourse | im:Moderate
        | hydrology:Seasonal
        | earth:Lowland
        | in (
            nca.ecology.ipcc:ColdTemperate,
            nca.ecology.ipcc:WarmTemperate,
            nca.ecology.ipcc:SubTropical,
            nca.ecology.ipcc:Tropical)
        | ecology:SubHumid
        | nca.ecosystem.iucn:SeasonalLowlandRiver ,

    // F1.4
    hydrology:Watercourse | im:Low
        | hydrology:Seasonal
        | in (earth:Alpine, earth:Montane, earth:Subalpine)
        | #
        | #
        | nca.ecosystem.iucn:SeasonalUplandStream ,

    // F1.6 — lowland is supporting evidence with weight 0.9.
    hydrology:Watercourse | #
        | hydrology:Episodic
        | earth:Lowland
        | in (
            nca.ecology.ipcc:SubTropical,
            nca.ecology.ipcc:WarmTemperate)
        | in (ecology:Arid, ecology:SemiArid)
        | nca.ecosystem.iucn:EpisodicAridRiver ,

    // F1.1
    hydrology:Watercourse | im:Low
        | hydrology:Permanent
        | in (earth:Alpine, earth:Montane, earth:Subalpine)
        | #
        | #
        | nca.ecosystem.iucn:PermanentUplandStream ,


    // ============================================================
    // PERMANENT LOWLAND: STRONGER SOFT SUPPORT FIRST
    // ============================================================

    // F1.2 — climate contributes weight 0.9 in the R model.
    hydrology:Watercourse | im:Moderate
        | hydrology:Permanent
        | earth:Lowland
        | in (
            nca.ecology.ipcc:ColdTemperate,
            nca.ecology.ipcc:WarmTemperate,
            nca.ecology.ipcc:SubTropical,
            nca.ecology.ipcc:Tropical)
        | #
        | nca.ecosystem.iucn:PermanentLowlandStream ,

    // F1.2 — aridity contributes weaker evidence, weight 0.5.
    hydrology:Watercourse | im:Moderate
        | hydrology:Permanent
        | earth:Lowland
        | #
        | ecology:Arid
        | nca.ecosystem.iucn:PermanentLowlandStream ,


    // ============================================================
    // LEGITIMATE SOFT-RULE FALLBACKS
    // ============================================================

    // F1.6 — lowland is soft, so it may be relaxed.
    hydrology:Watercourse | #
        | hydrology:Episodic
        | #
        | in (
            nca.ecology.ipcc:SubTropical,
            nca.ecology.ipcc:WarmTemperate)
        | in (ecology:Arid, ecology:SemiArid)
        | nca.ecosystem.iucn:EpisodicAridRiver ,

    // F1.2 — neither climate nor aridity support is available.
    hydrology:Watercourse | im:Moderate
        | hydrology:Permanent
        | earth:Lowland
        | #
        | #
        | nca.ecosystem.iucn:PermanentLowlandStream ,


    // ============================================================
    // FREEZE–THAW RESIDUAL APPROXIMATIONS
    // ============================================================
    // These are deliberately below permanence-specific classes.
    // Without seasonal-ice information, they are weaker proxies.

    hydrology:Watercourse | #
        | #
        | #
        | in (
            nca.ecology.ipcc:Boreal,
            nca.ecology.ipcc:Polar,
            nca.ecology.ipcc:SubPolar)
        | #
        | nca.ecosystem.iucn:FreezethawRiverStream ,

    hydrology:Watercourse | #
        | #
        | in (earth:Alpine, earth:Nival, earth:Subalpine)
        | #
        | #
        | nca.ecosystem.iucn:FreezethawRiverStream,
        
        // Approximation only: relaxes the R model's hard medium-hierarchy rule.
hydrology:Watercourse | im:Low
    | hydrology:Permanent
    | earth:Lowland
    | in (
        nca.ecology.ipcc:ColdTemperate,
        nca.ecology.ipcc:WarmTemperate,
        nca.ecology.ipcc:SubTropical,
        nca.ecology.ipcc:Tropical)
    | #
    | nca.ecosystem.iucn:PermanentLowlandStream 
        
}};


model nca.ecosystem.iucn:RiverStream
    type of nca.ecosystem.iucn:Ecosystem
    named biome_f1_river_stream

    observing
        type of hydrology:WaterBody
            named waterbody_type,

        level of (hydrology:StreamOrder of hydrology:Watershed)
            named watershed_hierarchy,

        type of hydrology:WaterPermanence
            named water_permanence_type,

        type of earth:ElevationZone
            named altitude_zone,

        type of nca.ecology.ipcc:ClimaticZone
            named climate_zone,

        type of ecology:MoistureRegime
            named evapotranspiration

    lookup (
        waterbody_type,
        watershed_hierarchy,
        water_permanence_type,
        altitude_zone,
        climate_zone,
        evapotranspiration,
        ?
    )
    into BIOME_F1_RIVER_STREAM_ECOSYSTEM_TYPES;  
    
    
define BIOME_TF1_PALUSTRINE_WETLAND_ECOSYSTEM_TYPES as {{
    landcover
    | annual_precipitation_total
    | annual_water_budget_total
    | seasonal_diurnal_air_temperature_variability
    | thermal_belts
    | annual_net_primary_productivity_total
    | floodplain
    | chemical_properties_base_saturation
    | peat_thickness
    | waterbody_type
    | water_permanence
    | canopy_cover
    | canopy_height
    | leaf_area_index
    | periodicity
    | ecosystem_type
    ---------------------------------------------------------------------------------------------------------------------------------


    // ============================================================
    // TF1.1 — TROPICAL FLOODED FOREST / PEAT FOREST
    // ============================================================

    // Branch 1, with soft vegetation support.
    in (landcover:Forest, landcover:Shrubland)
    | in (im:High, im:VeryHigh)
    | #
    | in (im:VeryLow, im:Low)
    | earth:Lowland
    | #
    | #
    | im:Low
    | im:High
    | #
    | #
    | ecology:Dense
    | #
    | in (im:High, im:VeryHigh)
    | #
    | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

    // Branch 1 hard-core fallback: canopy and LAI are soft.
    in (landcover:Forest, landcover:Shrubland)
    | in (im:High, im:VeryHigh)
    | #
    | in (im:VeryLow, im:Low)
    | earth:Lowland
    | #
    | #
    | im:Low
    | im:High
    | #
    | #
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

    // Branch 2: floodplain and moderate/high base saturation.
    in (landcover:Forest, landcover:Shrubland)
    | in (im:High, im:VeryHigh)
    | #
    | in (im:VeryLow, im:Low)
    | earth:Lowland
    | #
    | true
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | ecology:Dense
    | #
    | in (im:High, im:VeryHigh)
    | #
    | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

    // Branch 2 hard-core fallback.
    in (landcover:Forest, landcover:Shrubland)
    | in (im:High, im:VeryHigh)
    | #
    | in (im:VeryLow, im:Low)
    | earth:Lowland
    | #
    | true
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,


    // ============================================================
    // TF1.5 — EPISODIC ARID FLOODPLAIN
    // Highly distinctive hard-rule combination.
    // ============================================================

    in (landcover:Grassland, landcover:Wetland)
    | #
    | im:Low
    | #
    | #
    | im:Low
    | true
    | #
    | #
    | #
    | hydrology:Episodic
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:EpisodicAridFloodplain ,


    // ============================================================
    // TF1.3 — PERMANENT MARSH
    // ============================================================

    // Strong soft support: high NPP and no frequent fire.
    in (landcover:Grassland, landcover:Wetland)
    | #
    | #
    | #
    | #
    | im:High
    | #
    | #
    | #
    | #
    | hydrology:Permanent
    | #
    | #
    | #
    | false
    | nca.ecosystem.iucn:PermanentMarsh ,

    // High-NPP soft fallback.
    in (landcover:Grassland, landcover:Wetland)
    | #
    | #
    | #
    | #
    | im:High
    | #
    | #
    | #
    | #
    | hydrology:Permanent
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:PermanentMarsh ,

    // Represented hard-rule core.
    in (landcover:Grassland, landcover:Wetland)
    | #
    | #
    | #
    | #
    | #
    | #
    | #
    | #
    | #
    | hydrology:Permanent
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:PermanentMarsh ,


    // ============================================================
    // TF1.4 — SEASONAL FLOODPLAIN MARSH
    // ============================================================

    // Herbaceous seasonal branch, with soft NPP support.
    in (landcover:Grassland, landcover:Wetland)
    | #
    | #
    | #
    | #
    | im:High
    | true
    | #
    | #
    | #
    | hydrology:Seasonal
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

    // Herbaceous hard-core fallback.
    in (landcover:Grassland, landcover:Wetland)
    | #
    | #
    | #
    | #
    | #
    | true
    | #
    | #
    | #
    | hydrology:Seasonal
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

    // Woody branch: open canopy and low/moderate height are hard.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | #
    | im:High
    | true
    | #
    | #
    | #
    | hydrology:Seasonal
    | ecology:Open
    | in (im:VeryLow, im:Low, im:Moderate)
    | #
    | #
    | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

    // Woody hard-core fallback, relaxing soft NPP.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | #
    | #
    | true
    | #
    | #
    | #
    | hydrology:Seasonal
    | ecology:Open
    | in (im:VeryLow, im:Low, im:Moderate)
    | #
    | #
    | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,


    // ============================================================
    // TF1.6 — BOREAL/TEMPERATE/MONTANE PEAT BOG
    // Put before fen because low base saturation is diagnostic.
    // ============================================================

    // Herbaceous or lichen/moss peat bog, with soft support.
    in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland)
    | #
    | in (im:ModeratelyHigh, im:High)
    | #
    | #
    | in (im:Low, im:Moderate)
    | #
    | im:Low
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | #
    | in (im:High, im:VeryHigh)
    | false
    | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

    // Hard-core fallback: LAI and low fire exposure are soft.
    in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland)
    | #
    | in (im:ModeratelyHigh, im:High)
    | #
    | #
    | in (im:Low, im:Moderate)
    | #
    | im:Low
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

    // Woody peat-bog branch additionally requires short canopy.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | in (im:ModeratelyHigh, im:High)
    | #
    | #
    | in (im:Low, im:Moderate)
    | #
    | im:Low
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | in (im:VeryLow, im:Low)
    | #
    | #
    | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,


    // ============================================================
    // TF1.7 — BOREAL/TEMPERATE FEN
    // ============================================================

    // Strongest supported row.
    in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland)
    | #
    | in (im:ModeratelyHigh, im:High)
    | #
    | #
    | in (im:Moderate, im:High)
    | #
    | in (im:Moderate, im:High)
    | in (im:Moderate, im:High)
    | #
    | hydrology:Permanent
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:BorealTemperateFen ,

    // Relax permanence, which has weight 0.7.
    in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland)
    | #
    | in (im:ModeratelyHigh, im:High)
    | #
    | #
    | in (im:Moderate, im:High)
    | #
    | in (im:Moderate, im:High)
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:BorealTemperateFen ,

    // Hard-core fallback: NPP and base saturation are soft.
    in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland)
    | #
    | in (im:ModeratelyHigh, im:High)
    | #
    | #
    | #
    | #
    | #
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | #
    | #
    | #
    | nca.ecosystem.iucn:BorealTemperateFen ,


    // ============================================================
    // TF1.2 — SUBTROPICAL/TEMPERATE FORESTED WETLAND
    // Specific alternatives first; broad fallback last.
    // ============================================================

    // Floodplain branch.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | in (earth:Lowland, earth:Montane)
    | #
    | true
    | #
    | #
    | #
    | #
    | in (ecology:Open, ecology:Dense)
    | in (im:Low, im:Moderate, im:High)
    | #
    | #
    | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

    // Permanent-watercourse branch.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | in (earth:Lowland, earth:Montane)
    | #
    | #
    | #
    | #
    | hydrology:Watercourse
    | hydrology:Permanent
    | in (ecology:Open, ecology:Dense)
    | in (im:Low, im:Moderate, im:High)
    | #
    | #
    | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

    // Base-saturation-supported branch; base saturation is soft.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | in (earth:Lowland, earth:Montane)
    | #
    | #
    | in (im:Moderate, im:High)
    | #
    | #
    | #
    | in (ecology:Open, ecology:Dense)
    | in (im:Low, im:Moderate, im:High)
    | #
    | #
    | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

    // Peat-supported branch; peat is soft for TF1.2.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | in (earth:Lowland, earth:Montane)
    | #
    | #
    | #
    | in (im:Moderate, im:High)
    | #
    | #
    | in (ecology:Open, ecology:Dense)
    | in (im:Low, im:Moderate, im:High)
    | #
    | #
    | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

    // Lowest supported TF1.2 fallback.
    in (landcover:Forest, landcover:Shrubland)
    | #
    | #
    | #
    | in (earth:Lowland, earth:Montane)
    | #
    | #
    | #
    | #
    | #
    | #
    | in (ecology:Open, ecology:Dense)
    | in (im:Low, im:Moderate, im:High)
    | #
    | #
    | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland
}}; 

model nca.ecosystem.iucn:PalustrineWetland
    type of nca.ecosystem.iucn:Ecosystem
    named biome_tf1_palustrine_wetland

    observing
        landcover:LandCoverType
            named landcover,

        level of im:Yearly earth:PrecipitationVolume
            named annual_precipitation_total,

        level of (
            im:Yearly hydrology:WaterVolume
            caused by hydrology:WaterBalance
        )
            named annual_water_budget_total,

        level of im:Mean im:Changed
            primitive_characteristic.climate:SeasonalAmplitude
            earth:AtmosphericTemperature
            named seasonal_diurnal_air_temperature_variability,

        type of earth:ElevationZone
            named thermal_belts,

        level of ecology:NetPrimaryProduction
            named annual_net_primary_productivity_total,

        presence of hydrology:Floodplain
            named floodplain,

        level of (
            chemistry:Basic chemistry:ExchangeCapacity
            of chemistry:Cation
        )
            named chemical_properties_base_saturation,

        level of (
            im:Depth of landcover:PeatBog earth:Region
        )
            named peat_thickness,

        type of hydrology:WaterBody
            named waterbody_type,

        type of hydrology:WaterPermanence
            named water_permanence,

        level of ecology:CanopyCover
            named canopy_cover,

        level of (im:Mean im:Height of ecology:Canopy)
            named canopy_height,

        level of ecology:LeafAreaIndex
            named leaf_area_index,

        level of (
            risk:HazardMetric probability of chemistry:Fire
        )
            named periodicity

    lookup (
        landcover,
        annual_precipitation_total,
        annual_water_budget_total,
        seasonal_diurnal_air_temperature_variability,
        thermal_belts,
        annual_net_primary_productivity_total,
        floodplain,
        chemical_properties_base_saturation,
        peat_thickness,
        waterbody_type,
        water_permanence,
        canopy_cover,
        canopy_height,
        leaf_area_index,
        periodicity,
        ?
    )
    into BIOME_TF1_PALUSTRINE_WETLAND_ECOSYSTEM_TYPES;
