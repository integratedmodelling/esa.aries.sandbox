/* -----------------------------------------------------------------------------------------------------------------------------------------------
 * # 1) Comparison of the ecosystem type result between modelled & reference maps by ES types.
 */
@colormap(values = {
	true:	(0 255 0)
	false:	(255 0 0)	
})
model presence of (earth:Region with type of et_result_comparison:Level_3 nca.ecosystem.iucn:Ecosystem) named matching_ecosystem_type
	observing
		type of nca.ecosystem.iucn:Ecosystem named mapped_ecosystem_type,
		im:Reference et_result_comparison:Level_3 nca.ecosystem.iucn:EcosystemType named reference_ecosystem_type_level_3		  		                                                                                         
	lookup (mapped_ecosystem_type, reference_ecosystem_type_level_3, *, *, ?, *) 
		into IUCN_GET_LEVEL_CONSISTENCY_TABLE;
			
define table ecosystem_type_result_comparison_by_ecosystem_type_modelled_vs_reference_level_3 as {
	title: "Comparison of the ecosystem type result between modelled & reference maps by ES types - Level 3"
	label: "Areas of difference between modelled & reference maps by ES types - Level 3"
	target: im:Reference nca.ecosystem.iucn:EcosystemType
	columns:({ title: "{classifier}", filter: im:Reference nca.ecosystem.iucn:EcosystemType }), 	
	rows:   ({ title: "Consistency in (km²) between modelled & reference maps ({classifier})", target: im:Area in km^2, filter: presence of (earth:Region with type of et_result_comparison:Level_3 nca.ecosystem.iucn:Ecosystem) }
	         { title: "Total area (km²) according to reference map", summarize: [r1 + r2], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps (%)", summarize: [(r1 / (r1 + r2)) * 100], style: bold }
	        )
	};
	
@colormap(values = {
	true:	(0 255 0)
	false:	(255 0 0)	
})
model presence of (earth:Region with type of et_result_comparison:Level_2 nca.ecosystem.iucn:Ecosystem) named matching_ecosystem_type
	observing
		type of nca.ecosystem.iucn:Ecosystem named mapped_ecosystem_type,
		im:Reference et_result_comparison:Level_2 nca.ecosystem.iucn:EcosystemType named reference_ecosystem_type_level_2		  		                                                                                         
	lookup (mapped_ecosystem_type, *, reference_ecosystem_type_level_2, *, ?, *) 
		into IUCN_GET_LEVEL_CONSISTENCY_TABLE;
			
define table ecosystem_type_result_comparison_by_ecosystem_type_modelled_vs_reference_level_2 as {
	title: "Comparison of the ecosystem type result between modelled & reference maps by ES types - Level 2"
	label: "Areas of difference between modelled & reference maps by ES types - Level 2"
	target: im:Reference nca.ecosystem.iucn:EcosystemType
	columns:({ title: "{classifier}", filter: im:Reference nca.ecosystem.iucn:EcosystemType }), 	
	rows:   ({ title: "Consistency in (km²) between modelled & reference maps ({classifier})", target: im:Area in km^2, filter: presence of (earth:Region with type of et_result_comparison:Level_2 nca.ecosystem.iucn:Ecosystem) }
	         { title: "Total area (km²) according to reference map", summarize: [r1 + r2], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps (%)", summarize: [(r1 / (r1 + r2)) * 100], style: bold }
	        )
	};
	
@colormap(values = {
	true:	(0 255 0)
	false:	(255 0 0)	
})
model presence of (earth:Region with type of et_result_comparison:Level_1 nca.ecosystem.iucn:Ecosystem) named matching_ecosystem_type
	observing
		type of nca.ecosystem.iucn:Ecosystem named mapped_ecosystem_type,
		im:Reference et_result_comparison:Level_1 nca.ecosystem.iucn:EcosystemType named reference_ecosystem_type_level_1		  		                                                                                         
	lookup (mapped_ecosystem_type, *, *, reference_ecosystem_type_level_1, ?, *) 
		into IUCN_GET_LEVEL_CONSISTENCY_TABLE;
			
define table ecosystem_type_result_comparison_by_ecosystem_type_modelled_vs_reference_level_1 as {
	title: "Comparison of the ecosystem type result between modelled & reference maps by ES types - Level 1"
	label: "Areas of difference between modelled & reference maps by ES types - Level 1"
	target: im:Reference nca.ecosystem.iucn:EcosystemType
	columns:({ title: "{classifier}", filter: im:Reference nca.ecosystem.iucn:EcosystemType }), 	
	rows:   ({ title: "Consistency in (km²) between modelled & reference maps ({classifier})", target: im:Area in km^2, filter: presence of (earth:Region with type of et_result_comparison:Level_1 nca.ecosystem.iucn:Ecosystem) }
	         { title: "Total area (km²) according to reference map", summarize: [r1 + r2], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps (%)", summarize: [(r1 / (r1 + r2)) * 100], style: bold }
	        )
	};

/* -----------------------------------------------------------------------------------------------------------------------------------------------
 * # 2) Comparison of the ecosystem type result between modelled & reference maps by IUCN_GET levels.
 */
model et_result_comparison:IucnGetType
	observing
		type of nca.ecosystem.iucn:Ecosystem named mapped_ecosystem_type,
		im:Reference nca.ecosystem.iucn:EcosystemType named reference_ecosystem_type
	lookup (mapped_ecosystem_type, reference_ecosystem_type, *, *, *, ?)
		into IUCN_GET_LEVEL_CONSISTENCY_TABLE;	         

define table ecosystem_type_result_comparison_by_iucn_get_level_modelled_vs_reference as {
	title: "Comparison of the ecosystem type result between modelled & reference maps by IUCN_GET Levels"
	label: "Areas of difference between modelled & reference maps by IUCN_GET Levels"
	target: im:Reference nca.ecosystem.iucn:EcosystemType
	columns:({ title: "{classifier}", filter: im:Reference nca.ecosystem.iucn:EcosystemType }), 	
	rows:   ({ title: "Consistency in (km²) between modelled & reference maps ({classifier})", target: im:Area in km^2, filter: et_result_comparison:IucnGetType }
	         { title: "Total area (km²) according to reference map", summarize: [r1 + r2 + r3 + r4], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps - Level 1 (%)", summarize: [(r1 / (r1 + r2 + r3 + r4)) * 100], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps - Level 2 (%)", summarize: [(r2 / (r1 + r2 + r3 + r4)) * 100], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps - Level 3 (%)", summarize: [(r3 / (r1 + r2 + r3 + r4)) * 100], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps - Un-mapped (%)", summarize: [(r4 / (r1 + r2 + r3 + r4)) * 100], style: bold }
	        )
	};		