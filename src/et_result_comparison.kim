private namespace et_result_comparison
	using nca.ecosystem.iucn;

@colormap(values = {
	Level_1:	(0 128 255)
	Level_2: 	(0 255 255)
	Level_3: 	(0 255 0)
	UnMapped: 	(255 0 0)
})
abstract attribute IucnGetLevel
	describes es.nca:Ecosystem im:Type within earth:Location
	has disjoint children
		Level_1,
		Level_2,
		Level_3,
		UnMapped;

class IucnGetType is type of IucnGetLevel;

/* -----------------------------------------------------------------------------------------------------------------------------------------------
 * # Result comparison according to IUCN ES & ordered by Biome priorities.
