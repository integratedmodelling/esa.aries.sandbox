/* --- wildfire_disturbances_recurrence --- */
// primary_observations
// primary_observations for wildfire_disturbances_recurrence
model local:alessio.bulckaen:im.data.global:ecdc__wildfiredisturbances__recurrence__global__2002_2024
	as type of ecology.incubation:FireFrequency named wildfire_disturbances_recurrence
	lookup (self, ?) into
		self     | category                       
		-------------------------------------------
		0 to 0   | im:None ,
		1 to 1   | ecology.incubation:Annual      ,
		2 to 9   | ecology.incubation:SubDecadal  ,
		10 to 19 | ecology.incubation:Decadal     ,
		20 to 99 | ecology.incubation:MultiDecadal,
		> 100    | ecology.incubation:Centennial  ;

/* --- wildfire_disturbances_exposure --- */
// primary_observations
// primary_observations for wildfire_disturbances_exposure
model local:alessio.bulckaen:im.data.global:ecdc__wildfiredisturbances__disturbances_exposure_global_2019_2024
	as level of (risk:HazardMetric probability of chemistry:Fire) named wildfire_disturbances_exposure
	lookup (self, ?) into
		self        | category   
		--------------------------
		0 to 10     | im:None    ,
		10 to 340   | im:Low     ,
		340 to 670  | im:Moderate,
		670 to 1000 | im:High    ;	