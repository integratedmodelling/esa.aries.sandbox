/* --- surface_water_hydroform --- */
// secondary_observations
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform__global__1984_2017 as hydroform_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.hydroform_testing' as hydroform_rb_testing;
number hydroform_check
	observing hydroform_stac, hydroform_rb_testing
	set to [hydroform_stac - hydroform_rb_testing == 0 ? true : false];

// secondary_observations for surface_water_hydroform
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform__global__1984_2017
	as type of hydrology:WaterBody named hydroform_input;

number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform_meander__global__2004_2013 as hydroform_meander_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.hydroform_meander_testing' as hydroform_meander_rb_testing;
number hydroform_meander_check
	observing hydroform_meander_stac, hydroform_meander_rb_testing
	set to [hydroform_meander_stac - hydroform_meander_rb_testing == 0 ? true : false];

// secondary_observations for surface_water_hydroform
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform_meander__global__2004_2013
	as type of hydrology:WaterBody named hydroform_meander_input;

// primary_observations
// primary_observations for surface_water_hydroform
model type of hydrology:WaterBody named surface_water_hydroform
	observing 
		type of hydrology:WaterBody named hydroform_input,
		type of hydrology:WaterBody named hydroform_meander_input
	lookup (hydroform_input, hydroform_meander_input, ?) into
		hydroform_input | hydroform_meander_input | category                 
		---------------------------------------------------------------------
		1               | #                       | hydrology:Watercourse ,
		in (2 3)        | #                       | hydrology:InlandWaterBody ,
		#               | in (2 3)                | hydrology:Meander 
		;




/* --- surface_water_occurrence_regime --- */
// secondary_observations
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_seasonality__global__1984_2021 as occurrence_regime_seasonality_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.occurrence_regime_seasonality_testing' as occurrence_regime_seasonality_rb_testing;
number occurrence_regime_seasonality_check
	observing occurrence_regime_seasonality_stac, occurrence_regime_seasonality_rb_testing
	set to [occurrence_regime_seasonality_stac - occurrence_regime_seasonality_rb_testing == 0 ? true : false];

// secondary_observations for surface_water_occurrence_regime
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_seasonality__global__1984_2021
	as type of hydrology:WaterPermanence named occurrence_regime_seasonality_input;

number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_ephemeral__global__1984_2021 as occurrence_regime_ephemeral_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.occurrence_regime_ephemeral_testing' as occurrence_regime_ephemeral_rb_testing;
number occurrence_regime_ephemeral_check
	observing occurrence_regime_ephemeral_stac, occurrence_regime_ephemeral_rb_testing
	set to [occurrence_regime_ephemeral_stac - occurrence_regime_ephemeral_rb_testing == 0 ? true : false];

// secondary_observations for surface_water_occurrence_regime
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_ephemeral__global__1984_2021
	as type of hydrology:WaterPermanence named occurrence_regime_ephemeral_input;

number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_episodic__global__1984_2021 as occurrence_regime_episodic_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.occurrence_regime_episodic_testing' as occurrence_regime_episodic_rb_testing;
number occurrence_regime_episodic_check
	observing occurrence_regime_episodic_stac, occurrence_regime_episodic_rb_testing
	set to [occurrence_regime_episodic_stac - occurrence_regime_episodic_rb_testing == 0 ? true : false];

// secondary_observations for surface_water_occurrence_regime
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_episodic__global__1984_2021
	as type of hydrology:WaterPermanence named occurrence_regime_episodic_input;

// primary_observations
// primary_observations for surface_water_occurrence_regime
model type of hydrology:WaterPermanence named surface_water_occurrence_regime
	observing 
		type of hydrology:WaterPermanence named occurrence_regime_seasonality_input,
		type of hydrology:WaterPermanence named occurrence_regime_ephemeral_input,
		type of hydrology:WaterPermanence named occurrence_regime_episodic_input
	lookup (occurrence_regime_seasonality_input, occurrence_regime_ephemeral_input, occurrence_regime_episodic_input, ?) into
		occurrence_regime_seasonality_input | occurrence_regime_ephemeral_input | occurrence_regime_episodic_input | category           
		--------------------------------------------------------------------------------------------------------------------------------
		1                                   | #                                 | #                                | hydrology:Permanent ,
		2                                   | #                                 | #                                | hydrology:Seasonal ,
		#                                   | 1                                 | #                                | hydrology:Ephemeral ,
		#                                   | #                                 | in (1 2)                         | hydrology:Episodic 
		;




/* --- surface_water_watershed_hierarchy --- */
// primary_observations
// primary_observations for surface_water_watershed_hierarchy
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__watershed_hierarchy__global__2004_2013
	as level of (hydrology:StreamOrder of hydrology:Watershed) named surface_water_watershed_hierarchy
	lookup (self, ?) into
		self           | category   
		----------------------------
		in (1 2 3)     | im:Low ,
		in (4 5 6 7 8) | im:Moderate ,
		in (9 10)      | im:High 
		;




/* --- anthropogenic_managed_waters --- */
// secondary_observations
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform__global__1984_2017 as hydroform_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.hydroform_testing' as hydroform_rb_testing;
number hydroform_check
	observing hydroform_stac, hydroform_rb_testing
	set to [hydroform_stac - hydroform_rb_testing == 0 ? true : false];

// secondary_observations for anthropogenic_managed_waters
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform__global__1984_2017
	as type of hydrology.incubation:ManagedWaterBody named hydroform_input;

number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_canal as managed_waters_canal_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.managed_waters_canal_testing' as managed_waters_canal_rb_testing;
number managed_waters_canal_check
	observing managed_waters_canal_stac, managed_waters_canal_rb_testing
	set to [managed_waters_canal_stac - managed_waters_canal_rb_testing == 0 ? true : false];

// secondary_observations for anthropogenic_managed_waters
model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_canal
	as type of hydrology.incubation:ManagedWaterBody named managed_waters_canal_input;

number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_aquaculture__czechia_greece_norway__2017 as managed_waters_aquaculture_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.managed_waters_aquaculture_testing' as managed_waters_aquaculture_rb_testing;
number managed_waters_aquaculture_check
	observing managed_waters_aquaculture_stac, managed_waters_aquaculture_rb_testing
	set to [managed_waters_aquaculture_stac - managed_waters_aquaculture_rb_testing == 0 ? true : false];

// secondary_observations for anthropogenic_managed_waters
model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_aquaculture__czechia_greece_norway__2017
	as type of hydrology.incubation:ManagedWaterBody named managed_waters_aquaculture_input;

number local:justus.muhando:im.data.global:ecdc__anthropogenic__managed_waters_mariculture as managed_waters_mariculture_stac;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.managed_waters_mariculture_testing' as managed_waters_mariculture_rb_testing;
number managed_waters_mariculture_check
	observing managed_waters_mariculture_stac, managed_waters_mariculture_rb_testing
	set to [managed_waters_mariculture_stac - managed_waters_mariculture_rb_testing == 0 ? true : false];

// secondary_observations for anthropogenic_managed_waters
model local:justus.muhando:im.data.global:ecdc__anthropogenic__managed_waters_mariculture
	as type of hydrology.incubation:ManagedWaterBody named managed_waters_mariculture_input;

// primary_observations
// primary_observations for anthropogenic_managed_waters
model type of hydrology.incubation:ManagedWaterBody named anthropogenic_managed_waters
	observing 
		type of hydrology.incubation:ManagedWaterBody named hydroform_input,
		type of hydrology.incubation:ManagedWaterBody named managed_waters_canal_input,
		type of hydrology.incubation:ManagedWaterBody named managed_waters_aquaculture_input,
		type of hydrology.incubation:ManagedWaterBody named managed_waters_mariculture_input
	lookup (hydroform_input, managed_waters_canal_input, managed_waters_aquaculture_input, managed_waters_mariculture_input, ?) into
		hydroform_input | managed_waters_canal_input | managed_waters_aquaculture_input | managed_waters_mariculture_input | category                        
		-----------------------------------------------------------------------------------------------------------------------------------------------------
		3               | #                          | #                                | #                                | hydrology.incubation:Reservoir ,
		#               | 1                          | #                                | #                                | hydrology.incubation:Canal ,
		#               | #                          | 1                                | #                                | hydrology.incubation:Aquaculture ,
		#               | #                          | #                                | 1                                | hydrology.incubation:Mariculture 
		;




/* --- surface_water_hydroform_morphology_area --- */
// primary_observations
// primary_observations for surface_water_hydroform_morphology_area
model local:justus.muhando:im.data.global:ecdc__surfacewater__hydroform_morphology_area
	as level of (im:Minimum im:Area of earth:WaterBody) named surface_water_hydroform_morphology_area
	lookup (self, ?) into
		self     | category  
		---------------------
		< 2      | im:VeryLow ,
		2 to 100 | im:Low ,
		> 100    | im:High 
		;




/* --- surface_water_watershed_hydroform_density --- */
// primary_observations
// primary_observations for surface_water_watershed_hydroform_density
model local:justus.muhando:im.data.global:ecdc__surfacewater__watershed_hydroform_density
	as level of (im:Density of earth:WaterBody) named surface_water_watershed_hydroform_density
	lookup (self, ?) into
		self | category   
		------------------
		#    | im:None ,
		#    | im:Low ,
		#    | im:Moderate ,
		#    | im:High 
		;




/* --- surface_water_dominant_source --- */
// primary_observations
// primary_observations for surface_water_dominant_source
model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__dominant_source_global_2000_2100
	as type of hydrology:WaterSource named surface_water_dominant_source
	lookup (self, ?) into
		self | category               
		------------------------------
		< 0  | hydrology:Minerotrophic ,
		> 0  | hydrology:Ombrotrophic 
		;
