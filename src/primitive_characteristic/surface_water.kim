project private namespace primitive_characteristic.surface_water;


/* --- surface_water_hydroform --- */

// secondary_observations
// secondary_observations for surface_water_hydroform
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform as hydroform;
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform_meander__global__2004_2013 as hydroform_meander;

// primary_observations
// primary_observations for surface_water_hydroform
model type of hydrology:WaterBody named surface_water_hydroform
	observing 
		hydroform,
		hydroform_meander
	lookup (hydroform, hydroform_meander, ?) into
		hydroform		| hydroform_meander 	  | category                 
		---------------------------------------------------------------------
		1               | #                       | hydrology:Watercourse ,
		in (2 3)        | #                       | hydrology:InlandWaterBody ,
		#               | in (2 3)                | hydrology:Meander 
		;




/* --- surface_water_occurrence_regime --- */
// secondary_observations

// secondary_observations for surface_water_occurrence_regime
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_seasonality__global__1984_2021
	as occurrence_regime_seasonality;

// secondary_observations for surface_water_occurrence_regime
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_ephemeral__global__1984_2021
	as occurrence_regime_ephemeral;

// secondary_observations for surface_water_occurrence_regime
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__occurrence_regime_episodic__global__1984_2021
	as occurrence_regime_episodic;

// primary_observations
// primary_observations for surface_water_occurrence_regime
model type of hydrology:WaterPermanence named surface_water_occurrence_regime
	observing 
		occurrence_regime_seasonality,
		occurrence_regime_ephemeral,
		occurrence_regime_episodic
	lookup (occurrence_regime_seasonality, occurrence_regime_ephemeral, occurrence_regime_episodic, ?) into
		occurrence_regime_seasonality | occurrence_regime_ephemeral | occurrence_regime_episodic | category           
		--------------------------------------------------------------------------------------------------------------------------------
		1                                   | #                                 | #                                | hydrology:Permanent ,
		2                                   | #                                 | #                                | hydrology:Seasonal ,
		#                                   | 1                                 | #                                | hydrology:Ephemeral ,
		#                                   | #                                 | in (1 2)                         | hydrology:Episodic 
		;




/* --- surface_water_watershed_hierarchy --- */
// primary_observations
// primary_observations for surface_water_watershed_hierarchy

//surface_water_watershed_hierarchy

//number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__watershed_hierarchy as watershed_hierarchy_stac_dynamic_asset;
//number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__watershed_hierarchy__global__2004_2013 as watershed_hierarchy_stac_static_asset;
//number local:justus.muhando:esa.aries.sandbox:esa_weed_temp.watershed_hierarchy_testing as watershed_hierarchy_rb_testing;

number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__watershed_hierarchy__global__2004_2013 as test;

model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__watershed_hierarchy__global__2004_2013
	as level of (hydrology:StreamOrder of hydrology:Watershed) named surface_water_watershed_hierarchy
	lookup (self, ?) into
		self             | category   
		----------------------------
		in (0 1 2 3)     | im:Low ,
		in (4 5 6 7 8)   | im:Moderate ,
		in (9 10)        | im:High 
		;

/* --- surface_water_hydroform_morphology_area --- */
// primary_observations
// primary_observations for surface_water_hydroform_morphology_area


number local:justus.muhando:im.data.global:ecdc__surfacewater__hydroform_morphology_area as test2;

model local:justus.muhando:im.data.global:ecdc__surfacewater__hydroform_morphology_area
	as level of (im:Minimum im:Area of earth:WaterBody) named surface_water_hydroform_morphology_area
	lookup (self, ?) into
		self     | category  
		---------------------
		< 2      | im:VeryLow ,
		2 to 100 | im:Low ,
		> 100    | im:High;




/* --- surface_water_watershed_hydroform_density --- */
// primary_observations
// primary_observations for surface_water_watershed_hydroform_density

//watershed_hydroform_density
//number local:justus.muhando:im.data.global:ecdc__surfacewater__watershed_hydroform_density as watershed_hydroform_density_stac_dynamic_asset;
//number local:justus.muhando:esa.aries.sandbox:esa_weed_temp.watershed_hydroform_density_testing as watershed_hydroform_density_rb_testing;

model local:justus.muhando:im.data.global:ecdc__surfacewater__watershed_hydroform_density
	as level of (im:Density of earth:WaterBody) named surface_water_watershed_hydroform_density
	lookup (self, ?) into
		self | category   
		------------------
		#    | im:None ,
		#    | im:Low ,
		#    | im:Moderate ,
		#    | im:High ;



/* --- surface_water_dominant_source --- */
// primary_observations
// primary_observations for surface_water_dominant_source

//water_dominant_source
//number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__dominant_source as dominant_source_stac_dynamic_asset;
//number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__dominant_source_global_2000_2100 as dominant_source_stac_static_asset;
//number local:justus.muhando:esa.aries.sandbox:esa_weed_temp.dominant_source_index_testing as dominant_source_rb_testing;


model local:alessio.bulckaen:im.data.global:ecdc__surfacewater__dominant_source_global_2000_2100
	as type of hydrology:WaterSource named surface_water_dominant_source
	lookup (self, ?) into
		self | category               
		------------------------------
		< 0  | hydrology:Minerotrophic ,
		> 0  | hydrology:Ombrotrophic 
		;
