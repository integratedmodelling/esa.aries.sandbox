model 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.managed_waters_mariculture_testing'
	as presence of landcover:WaterBody earth:Region for agriculture:Mariculture 
	named managed_waters_mariculture_testing
	set to [self == 1 ? true : false];
	

/* ----------------------------------------------------------------------------------------------------------------------------- 
 * # 5) Managed waters aquaculture.
 */
//model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_aquaculture__czechia_greece_norway__2017 
model 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.managed_waters_aquaculture_testing'
	as presence of hydrology.incubation:Aquaculture earth:Region named managed_waters_aquaculture
	set to [self == 1 ? true : false];

/* ----------------------------------------------------------------------------------------------------------------------------- 
 * # 6) Managed water body.
 */	
model type of hydrology.incubation:ManagedWaterBody named managed_waterbody
	observing
		presence of hydrology.incubation:Canal earth:Region named managed_waters_canal_presence,
		presence of hydrology.incubation:Reservoir earth:Region named managed_waters_reservoir_presence,
		presence of hydrology.incubation:Aquaculture earth:Region named managed_waters_aquaculture_presence
	lookup (managed_waters_canal_presence, managed_waters_reservoir_presence, managed_waters_aquaculture_presence, ?) into
			canal_presence	|	reservoir_presence	|	aquaculture_presence	|	managed_waterbody_type
		------------------------------------------------------------------------------------------------------------------
				true  		|			#			|			#				|	hydrology.incubation:Canal			,
				 #  		|		   true			|			#				|	hydrology.incubation:Reservoir		,
				 #  		|			#			|		   true				|	hydrology.incubation:Aquaculture	;
				 
model 'local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_meadows_and_pastures__global__2018'
	as type of ecology:HerbaceousVegetationLanduse classified into
	//as type of Grassland named grassland_type classified into
	ecology:CultivatedGrassland if 1,
	ecology:NaturalSeminaturalGrassland if 2,
	ecology:OpenShrubland if 3;

// temporary change of URN
model
local:rubencc:im.data.global:im-data-global-landcover.global_land_use_annual_crops_2018,
local:rubencc:im.data.global:im-data-global-landcover.global_land_use_annual_crops_2021,
local:rubencc:im.data.global:im-data-global-landcover.global_land_use_annual_crops_2024 
//model
//	  local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_annual_crops_2018,
//	  local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_annual_crops_2021,
//	  local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_annual_crops_2024
	as presence of agriculture:Annual agriculture:Cropfield named annual_crop 
	set to [self==100 ? true : false];

//temporary change of URN
model local:rubencc:im.data.global:im-data-global-landcover.global_land_use_perennial_crops_2020
//model
//	  local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_perennial_crops_2018
	as presence of agriculture:Perennial agriculture:Cropfield named perennial_crop
	set to [self==2 ? true : false];

model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_meadows_and_pastures_global_2018,
	  local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_meadows_and_pastures_global_2021,
	  local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_meadows_and_pastures_global_2024
	as presence of agriculture:Pastureland earth:Region named pasture
	set to [self==1 ? true : false]; 
	
model type of agriculture:AgriculturalLandUse named land_use
observing
	presence of agriculture:Annual agriculture:Cropfield named annual_crop,
	presence of agriculture:Perennial agriculture:Cropfield named perennial_crop,
	presence of agriculture:Pastureland earth:Region named pasture 
		lookup into
		annual_crop | perennial_crop| pasture | land_use
		-------------------------------------------------
			true 	|		#		|	 #	  | agriculture:Annual,
			 # 		|	   true		|	 #	  | agriculture:Perennial,
 			 # 		|	    #		|   true  | agriculture:Pastureland;
//model 'ecdc_land_use'
//	as type of agriculture:CropLifespan named land_use classified into
//	agriculture:Annual if 100,
//	agriculture:Perennial if 2;

//model 'ecdc_land_use'
//	as type of agriculture:CropLifespan named land_use classified into
//	agriculture:Annual if 100,
//	agriculture:Perennial if 2;

number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.land_use_annual_crops_testing'
	as land_use_annual_crops_testing;
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.land_use_perennial_crops_testing'
	as land_use_perennial_crops_testing;
model type of agriculture:CropLifespan 
	named land_use 
	observing
		land_use_annual_crops_testing,
		land_use_perennial_crops_testing
	lookup (land_use_annual_crops_testing, land_use_perennial_crops_testing, ?) into
		land_use_annual_crops	|	land_use_perennial_crops	|	category
		---------------------------------------------------------------------------------------------------------
			     100		    |			#				|	agriculture:Annual	,
			     #		     	|			2				|	agriculture:Perennial;
		

//model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__crop_type_rice_paddies
//model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__crop_type_rice_paddies_global_2024
model 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.crop_type_rice_paddies_testing'
	as type of agriculture:Crop named crop_type classified into
	agriculture:Rice if 1;

//model 'ecdc_settlement_type'
model 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.settlement_type_testing'
	as level of demography:SettlementDensity named settlement_type classified into
		demography:Urban if in ( 30 23 22 ),
		demography:Suburban if 21,
		demography:Rural if 13,
		demography:Sparse if in ( 12 11 );
	
//model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__infrastructure_type_road_transportation
//'ecdc_infrastructure_type_road_transportation'
//model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__infrastructure_type_road_transportation_global_1997_2017
model 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.infrastructure_type_road_transportation_testing'
	as im:Density of infrastructure:Road named infrastructure_type_road_transportation
//	classified into
	lookup into
		road_density 	| category
		-------------------------------------------
		 0 to 0.25 		| im:Low,
		 0.25 to 0.5	| im:Moderate,
			>0.5 		| im:High; 

number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__crop_type_rice_paddies as test_crop_type_rice_paddies;
number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_meadows_and_pastures as test_land_use_meadows_and_pastures;
number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__infrastructure_type_road_transportation as test_infrastructure;