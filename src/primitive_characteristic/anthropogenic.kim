project private namespace primitive_characteristic.anthropogenic;

/* --- anthropogenic_land_use --- */

// secondary_observations for anthropogenic_land_use
number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_annual_crops as land_use_annual_crops;
number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__land_use_perennial_crops as land_use_perennial_crops;

// primary_observations
// primary_observations for anthropogenic_land_use
model type of agriculture:AgriculturalLandUse named anthropogenic_land_use
	observing 
		land_use_annual_crops,
		land_use_perennial_crops
	lookup (land_use_annual_crops, land_use_perennial_crops, ?) into
		land_use_annual_crops 		| land_use_perennial_crops 		 | category             
		------------------------------------------------------------------------------------
		100                         | #                              | agriculture:Annual   ,
		#                           | 2                              | agriculture:Perennial;


/* --- anthropogenic_crop_type --- */

// primary_observations
// primary_observations for anthropogenic_crop_type
model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__crop_type_rice_paddies_global_2024
//local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__crop_type_rice_paddies 
	as type of agriculture:Crop named anthropogenic_crop_type
	lookup (self, ?) into
		self | category        
		-----------------------
		1    | agriculture:Rice;


/* --- anthropogenic_mining_areas --- */
// primary_observations
// primary_observations for anthropogenic_mining_areas
model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__mining_areas
	as presence of landcover:MineralExtraction earth:Region named anthropogenic_mining_areas
	lookup (self, ?) into
		self | category
		---------------
		1    | true ,
		#    | false;

/* --- anthropogenic_managed_waters --- */

// secondary_observations for anthropogenic_managed_waters
number local:alessio.bulckaen:im.data.global:ecdc__surfacewater__hydroform as hydroform;
number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_canal as managed_waters_canal;
number local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_aquaculture as managed_waters_aquaculture;
number local:justus.muhando:im.data.global:ecdc__anthropogenic__managed_waters_mariculture as managed_waters_mariculture;

// primary_observations
// primary_observations for anthropogenic_managed_waters
model type of hydrology.incubation:ManagedWaterBody named anthropogenic_managed_waters
	observing 
		hydroform,
		managed_waters_canal,
		managed_waters_aquaculture,
		managed_waters_mariculture
	lookup (hydroform, managed_waters_canal, managed_waters_aquaculture, managed_waters_mariculture, ?) into
		hydroform 		| managed_waters_canal 		 | managed_waters_aquaculture 		| managed_waters_mariculture 	   | category                        
		-----------------------------------------------------------------------------------------------------------------------------------------------------
		3               | #                          | #                                | #                                | hydrology.incubation:Reservoir ,
		#               | 1                          | #                                | #                                | hydrology.incubation:Canal ,
		#               | #                          | 1                                | #                                | hydrology.incubation:Aquaculture ,
		#               | #                          | #                                | 1                                | hydrology.incubation:Mariculture ;




