/* ----------------------------------------------------------------------------------------------------------------------------- 
 * # 3) Managed waters reservoir.
 */

model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_reservoir__greece__2022
	as presence of hydrology.incubation:Reservoir earth:Region named managed_waters_reservoir_greece
	set to [self == 3 ? true : false]
	over space(shape="POLYGON ((29.63220162 34.9966406, 29.63220162 41.79065352, 19.35250178 41.79065352, 19.35250178 34.9966406, 29.63220162 34.9966406))");
	
model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_reservoir__viet_nam__2022
	as presence of hydrology.incubation:Reservoir earth:Region named managed_waters_reservoir_viet_nam
	set to [self == 3 ? true : false]
	over space(shape="POLYGON ((109.48767457 8.56539723, 109.48767457 23.43431472, 101.9644288 23.43431472, 101.9644288 8.56539723, 109.48767457 8.56539723))");

model local:alessio.bulckaen:im.data.global:ecdc__anthropogenic__managed_waters_reservoir__colombia__2022 
	as presence of hydrology.incubation:Reservoir earth:Region named managed_waters_reservoir_colombia
	set to [self == 3 ? true : false]
	over space(shape="POLYGON ((-66.87024263 -4.0466187, -66.87024263 12.44063129, -78.9991173 12.44063129, -78.9991173 -4.0466187, -66.87024263 -4.0466187))");
		 
