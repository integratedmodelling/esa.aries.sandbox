private namespace primitive_characteristic.ecosystem_typology.iucn
using primitive_characteristic.anthropogenic, 
	  primitive_characteristic.atmospheric_disturbance,
	  primitive_characteristic.climate,
	  primitive_characteristic.coastal,
	  primitive_characteristic.ecosystem_function,
	  primitive_characteristic.geothermal_energy,
	  primitive_characteristic.soil,
	  primitive_characteristic.surface_water,
	  primitive_characteristic.vegetation,
	  primitive_characteristic.wildfire_disturbance, 
	  nca.ecosystem.iucn,
	  nca.ecology.ipcc,
	(BIOME_F1_RIVER_STREAM_ECOSYSTEM_TYPES,
	 BIOME_F2_LAKE_ECOSYSTEM_TYPES,
	 BIOME_F3_ARTIFICIAL_WETLAND_ECOSYSTEM_TYPES,
	 BIOME_FM1_SEMICONFINED_TRANSITIONAL_WATER_ECOSYSTEM_TYPES,
	 BIOME_M1_MARINE_SHELF_ECOSYSTEM_TYPES,
//	 BIOME_M2_PELAGIC_OCEAN_WATER_ECOSYSTEM_TYPES,
//	 BIOME_M3_DEEP_SEA_FLOOR_ECOSYSTEM_TYPES,
	 BIOME_M4_ANTHROPOGENIC_MARINE_ECOSYSTEM_TYPES,	
	 BIOME_T1_TROPICAL_SUBTROPICAL_FOREST_ECOSYSTEM_TYPES,
	 BIOME_T2_TEMPERATE_BOREAL_FOREST_WOODLAND_ECOSYSTEM_TYPES,
	 BIOME_T3_SHRUBLAND_SHRUBBY_WOODLAND_ECOSYSTEM_TYPES,
	 BIOME_T4_SAVANNA_GRASSLAND_ECOSYSTEM_TYPES,
	 BIOME_T5_DESERT_SEMIDESERT_ECOSYSTEM_TYPES,
	 BIOME_T6_POLAR_ALPINE_ECOSYSTEM_TYPES,
	 BIOME_T7_INTENSIVE_LAND_USE_SYSTEM_ECOSYSTEM_TYPES,
	 BIOME_TF1_PALUSTRINE_WETLAND_ECOSYSTEM_TYPES,
	 BIOME_MFT1_BRACKISH_TIDAL_ECOSYSTEM_TYPES,
	 BIOME_MT1_SHORELINE_ECOSYSTEM_TYPES,
	 BIOME_MT2_SUPRALITTORAL_COASTAL_ECOSYSTEM_TYPES,
	 BIOME_MT3_ANTHROPOGENIC_SHORELINE_ECOSYSTEM_TYPES
	 ) from table.ecosystem.typology.iucn;

model
	local:alessio.bulckaen:im.data.global:im-data-global-landcover.global_glc_fcs30d_landcover_epsg4326_30m_2018_mosaic,
	local:alessio.bulckaen:im.data.global:im-data-global-landcover.global_glc_fcs30d_landcover_epsg4326_30m_2019_mosaic,
	local:alessio.bulckaen:im.data.global:im-data-global-landcover.global_glc_fcs30d_landcover_epsg4326_30m_2020_mosaic,
	local:alessio.bulckaen:im.data.global:im-data-global-landcover.global_glc_fcs30d_landcover_epsg4326_30m_2021_mosaic,
	local:alessio.bulckaen:im.data.global:im-data-global-landcover.global_glc_fcs30d_landcover_epsg4326_30m_2022_mosaic
	as landcover:LandCoverType named glc_fcs30 classified into
	landcover:BareArea if in ( 200 201 202 ),
	landcover:Grassland if in ( 10 11 20 130 153 182 186 ),
	landcover:ArtificialSurface if 190,
	landcover:LichenMoss if 140,
	landcover:Shrubland if in ( 12 120 121 122 152 ),
	landcover:GlacierPerpetualSnow if 220,
	landcover:Forest if in ( 12 51 52 61 62 71 72 81 82 91 92 181 185 );	

//--- BIOME F1 - RiverStream annotation---
model nca.ecosystem.iucn:RiverStream type of nca.ecosystem.iucn:Ecosystem named biome_f1_river_stream
	observing
		type of hydrology:WaterBody named waterbody_type,
		level of (hydrology:StreamOrder of hydrology:Watershed) named watershed_hierarchy,
		type of hydrology:WaterPermanence named water_permanence_type,
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration
	lookup (waterbody_type, watershed_hierarchy, water_permanence_type, altitude_zone, climate_zone, evapotranspiration, ?)
	into BIOME_F1_RIVER_STREAM_ECOSYSTEM_TYPES;

//--- BIOME F2 - Lake annotation---
model nca.ecosystem.iucn:Lake type of nca.ecosystem.iucn:Ecosystem named biome_f2_lake
	observing
		type of hydrology:WaterBody named waterbody_type,
		type of hydrology:WaterPermanence named water_permanence_type,
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration,
		level of (im:Minimum im:Area of earth:WaterBody) named hydroform_morphology_area,
		level of (im:Differential earth:AtmosphericTemperature) named continentality,
		landcover:LandCoverType named landcover,
		level of im:Mean earth:AtmosphericTemperature during earth:Summer named summer_diurnal_air_temperature_mean,
		level of im:Mean earth:AtmosphericTemperature during earth:Winter named winter_diurnal_air_temperature_mean,
		type of nca.ecology.ipcc:ClimaticZone  named climate_type,
		type of hydrology:WaterSource named dominant_source,
		level of (chemistry:Basic chemistry:ExchangeCapacity of chemistry:Cation) named chemical_properties_base_saturation,
		presence of earth:Crust physical:Thermal earth:Region with im:High im:Energy named energy_geothermal,
		level of chemistry:Ph named chemical_properties_ph_status
	lookup (waterbody_type, water_permanence_type, altitude_zone, climate_zone, evapotranspiration, hydroform_morphology_area, continentality, landcover, summer_diurnal_air_temperature_mean, winter_diurnal_air_temperature_mean, climate_type, dominant_source, chemical_properties_base_saturation, energy_geothermal, chemical_properties_ph_status, ?)
	into BIOME_F2_LAKE_ECOSYSTEM_TYPES;

//--- BIOME F3 - ArtificialWetland annotation---
model nca.ecosystem.iucn:ArtificialWetland type of nca.ecosystem.iucn:Ecosystem named biome_f3_artificial_wetland
	observing
		type of hydrology:WaterBody named waterbody_type,
		type of hydrology:WaterPermanence named water_permanence_type,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration,
		level of (im:Minimum im:Area of earth:WaterBody) named hydroform_morphology_area,
		landcover:LandCoverType named landcover,
		type of hydrology.incubation:ManagedWaterBody named managed_water,
		type of agriculture:AgriculturalLandUse named land_use,
		type of demography:SettlementDensity infrastructure:HumanSettlement named settlement_type,
		presence of landcover:MineralExtraction earth:Region named mining_area,
		type of agriculture:Crop named crop_type,
		presence of hydrology:Floodplain named floodplain
	lookup (waterbody_type, water_permanence_type, climate_zone, evapotranspiration, hydroform_morphology_area, landcover, managed_water, land_use, settlement_type, mining_area, crop_type, floodplain, ?)
	into BIOME_F3_ARTIFICIAL_WETLAND_ECOSYSTEM_TYPES;

//--- BIOME FM1 - SemiconfinedTransitionalWater annotation---
model nca.ecosystem.iucn:SemiconfinedTransitionalWater type of nca.ecosystem.iucn:Ecosystem named biome_fm1_semiconfined_transitional_water
	observing
		type of hydrology:WaterBody named waterbody_type,
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration,
		level of (im:Energy of physical:Wave) named wave_energy,
		level of earth:Littoral hydrology:WaterVolume named freshwater_inflow,
		level of (earth:Littoral chemistry:Salinity) named salt_exposure,
		type of hydrology:Tidal earth:Location named tidal_zone
	lookup (waterbody_type, altitude_zone, climate_zone, evapotranspiration, wave_energy, freshwater_inflow, salt_exposure, tidal_zone, ?)
	into BIOME_FM1_SEMICONFINED_TRANSITIONAL_WATER_ECOSYSTEM_TYPES;

//--- BIOME M1 - MarineShelf annotation---
model nca.ecosystem.iucn:MarineShelf type of nca.ecosystem.iucn:Ecosystem named biome_m1_marine_shelf
	observing
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		level of (im:Energy of physical:Wave) named wave_energy,
		type of hydrology:Tidal earth:Location named tidal_zone,
		level of (ratio of earth:Dry soil:Soil im:Mass to soil:Soil im:Volume) named physical_properties_bulk_density
	lookup (climate_zone, wave_energy, tidal_zone, physical_properties_bulk_density, ?)
	into BIOME_M1_MARINE_SHELF_ECOSYSTEM_TYPES;

