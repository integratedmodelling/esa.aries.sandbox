//--- BIOME T1 - TropicalSubtropicalForest annotation---
model nca.ecosystem.iucn:TropicalSubtropicalForest type of nca.ecosystem.iucn:Ecosystem named biome_t1_tropical_subtropical_forest
	observing
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration,
		landcover:LandCoverType named landcover,
		type of nca.ecology.ipcc:ClimaticZone  named climate_type,
		level of (chemistry:Basic chemistry:ExchangeCapacity of chemistry:Cation) named chemical_properties_base_saturation,
		level of chemistry:Ph named chemical_properties_ph_status,
		level of ecology:NetPrimaryProduction named annual_net_primary_productivity_total,
		level of im:Yearly earth:PrecipitationVolume named annual_precipitation_total,
		level of (im:Mean im:Height of ecology:Canopy) named canopy_height,
		level of ecology:CanopyCover named canopy_cover,
		level of ecology:LeafAreaIndex named leaf_area_index,
		type of ecology:LeafPhenology named phenology,
		level of (ratio of im:Area to earth:Dry im:Mass of biology:Leaf) named specific_leaf_area,
		level of (physical.incubation:Shadow im:Area of biology:Leaf) named leaf_size,
		level of (im:Yearly hydrology:WaterVolume caused by hydrology:WaterBalance) named annual_water_budget_total,
		level of im:Daily im:Mean earth:AtmosphericTemperature during im:Year named annual_diurnal_air_temperature_mean,
		presence of ecology:Tropical earth:Region with im:Mean im:Maximum earth:WindSpeed of earth:Storm named tropical_storms_exposure,
		level of (risk:HazardMetric probability of chemistry:Fire) named exposure,
		level of (hydrology:WaterVolume caused by hydrology:WaterBalance during earth:Winter) named winter_water_budget_total,
		level of im:Mean im:Changed primitive_characteristic.climate:SeasonalAmplitude earth:AtmosphericTemperature named seasonal_diurnal_air_temperature_variability,
		level of (proportion of chemistry:Nitrogen in soil:Soil) named chemical_properties_nitrogen
	lookup (altitude_zone, climate_zone, evapotranspiration, landcover, climate_type, chemical_properties_base_saturation, chemical_properties_ph_status, annual_net_primary_productivity_total, annual_precipitation_total, canopy_height, canopy_cover, leaf_area_index, phenology, specific_leaf_area, leaf_size, annual_water_budget_total, annual_diurnal_air_temperature_mean, tropical_storms_exposure, exposure, winter_water_budget_total, seasonal_diurnal_air_temperature_variability, chemical_properties_nitrogen, ?)
	into BIOME_T1_TROPICAL_SUBTROPICAL_FOREST_ECOSYSTEM_TYPES;

//--- BIOME T2 - TemperateBorealForestWoodland annotation---
model nca.ecosystem.iucn:TemperateBorealForestWoodland type of nca.ecosystem.iucn:Ecosystem named biome_t2_temperate_boreal_forest_woodland
	observing
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration,
		level of (im:Differential earth:AtmosphericTemperature) named continentality,
		landcover:LandCoverType named landcover,
		level of im:Mean earth:AtmosphericTemperature during earth:Summer named summer_diurnal_air_temperature_mean,
		level of im:Mean earth:AtmosphericTemperature during earth:Winter named winter_diurnal_air_temperature_mean,
		type of nca.ecology.ipcc:ClimaticZone  named climate_type,
		level of (chemistry:Basic chemistry:ExchangeCapacity of chemistry:Cation) named chemical_properties_base_saturation,
		level of chemistry:Ph named chemical_properties_ph_status,
		level of ecology:NetPrimaryProduction named annual_net_primary_productivity_total,
		level of im:Mean primitive_characteristic.climate:SeasonalAmplitude earth:AtmosphericTemperature named seasonal_diurnal_air_temperature_amplitude,
		level of im:Yearly earth:PrecipitationVolume named annual_precipitation_total,
		level of (im:Mean im:Height of ecology:Canopy) named canopy_height,
		level of ecology:CanopyCover named canopy_cover,
		level of ecology:LeafAreaIndex named leaf_area_index,
		type of ecology:LeafPhenology named phenology,
		level of (ratio of im:Area to earth:Dry im:Mass of biology:Leaf) named specific_leaf_area,
		level of (physical.incubation:Shadow im:Area of biology:Leaf) named leaf_size,
		level of (im:Yearly hydrology:WaterVolume caused by hydrology:WaterBalance) named annual_water_budget_total,
		level of im:Daily im:Mean earth:AtmosphericTemperature during im:Year named annual_diurnal_air_temperature_mean,
		level of (risk:HazardMetric probability of chemistry:Fire) named exposure,
		level of (hydrology:WaterVolume caused by hydrology:WaterBalance during earth:Winter) named winter_water_budget_total,
		level of im:Mean im:Changed primitive_characteristic.climate:SeasonalAmplitude earth:AtmosphericTemperature named seasonal_diurnal_air_temperature_variability,
		level of (proportion of chemistry:Nitrogen in soil:Soil) named chemical_properties_nitrogen,
		type of ecology:LeafType named leaf_shape,
		level of (im:Depth of landcover:PeatBog earth:Region) named peat_thickness,
		count of im:Yearly im:Occurrence of chemistry:Fire named recurrence,
		level of soil.incubation:Fertility named fertility
	lookup (altitude_zone, climate_zone, evapotranspiration, continentality, landcover, summer_diurnal_air_temperature_mean, winter_diurnal_air_temperature_mean, climate_type, chemical_properties_base_saturation, chemical_properties_ph_status, annual_net_primary_productivity_total, seasonal_diurnal_air_temperature_amplitude, annual_precipitation_total, canopy_height, canopy_cover, leaf_area_index, phenology, specific_leaf_area, leaf_size, annual_water_budget_total, annual_diurnal_air_temperature_mean, exposure, winter_water_budget_total, seasonal_diurnal_air_temperature_variability, chemical_properties_nitrogen, leaf_shape, peat_thickness, recurrence, fertility, ?)
	into BIOME_T2_TEMPERATE_BOREAL_FOREST_WOODLAND_ECOSYSTEM_TYPES;

