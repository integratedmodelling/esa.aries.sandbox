//--- BIOME M4 - AnthropogenicMarine annotation---
model nca.ecosystem.iucn:AnthropogenicMarine type of nca.ecosystem.iucn:Ecosystem named biome_m4_anthropogenic_marine
	observing
		type of hydrology.incubation:ManagedWaterBody named managed_water
	lookup (managed_water, ?)
	into BIOME_M4_ANTHROPOGENIC_MARINE_ECOSYSTEM_TYPES;

//--- BIOME MFT1 - BrackishTidal annotation---
model nca.ecosystem.iucn:BrackishTidal type of nca.ecosystem.iucn:Ecosystem named biome_mft1_brackish_tidal
	observing
		type of hydrology:WaterBody named waterbody_type,
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		landcover:LandCoverType named landcover,
		level of im:Mean earth:AtmosphericTemperature during earth:Winter named winter_diurnal_air_temperature_mean,
		type of nca.ecology.ipcc:ClimaticZone  named climate_type,
		level of (im:Energy of physical:Wave) named wave_energy,
		level of earth:Littoral hydrology:WaterVolume named freshwater_inflow,
		level of (earth:Littoral chemistry:Salinity) named salt_exposure,
		type of hydrology:Tidal earth:Location named tidal_zone,
		level of ecology:NetPrimaryProduction named annual_net_primary_productivity_total,
		level of im:Mean primitive_characteristic.climate:SeasonalAmplitude earth:AtmosphericTemperature named seasonal_diurnal_air_temperature_amplitude,
		level of im:Yearly earth:PrecipitationVolume named annual_precipitation_total,
		level of earth:Littoral geography:Slope named slope,
		level of (im:Mean im:Height of ecology:Canopy) named canopy_height
	lookup (waterbody_type, altitude_zone, climate_zone, landcover, winter_diurnal_air_temperature_mean, climate_type, wave_energy, freshwater_inflow, salt_exposure, tidal_zone, annual_net_primary_productivity_total, seasonal_diurnal_air_temperature_amplitude, annual_precipitation_total, slope, canopy_height, ?)
	into BIOME_MFT1_BRACKISH_TIDAL_ECOSYSTEM_TYPES;

//--- BIOME MT1 - Shoreline annotation---
model nca.ecosystem.iucn:Shoreline type of nca.ecosystem.iucn:Ecosystem named biome_mt1_shoreline
	observing
		type of earth:ElevationZone named altitude_zone,
		landcover:LandCoverType named landcover,
		level of (chemistry:Basic chemistry:ExchangeCapacity of chemistry:Cation) named chemical_properties_base_saturation,
		level of (im:Energy of physical:Wave) named wave_energy,
		level of (earth:Littoral chemistry:Salinity) named salt_exposure,
		type of hydrology:Tidal earth:Location named tidal_zone,
		level of (ratio of earth:Dry soil:Soil im:Mass to soil:Soil im:Volume) named physical_properties_bulk_density,
		level of earth:Littoral geography:Slope named slope
	lookup (altitude_zone, landcover, chemical_properties_base_saturation, wave_energy, salt_exposure, tidal_zone, physical_properties_bulk_density, slope, ?)
	into BIOME_MT1_SHORELINE_ECOSYSTEM_TYPES;

//--- BIOME MT2 - SupralittoralCoastal annotation---
model nca.ecosystem.iucn:SupralittoralCoastal type of nca.ecosystem.iucn:Ecosystem named biome_mt2_supralittoral_coastal
	observing
		type of earth:ElevationZone named altitude_zone,
		earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_zone,
		type of ecology:MoistureRegime named evapotranspiration,
		level of (im:Differential earth:AtmosphericTemperature) named continentality,
		landcover:LandCoverType named landcover,
		level of (im:Energy of physical:Wave) named wave_energy,
		level of (earth:Littoral chemistry:Salinity) named salt_exposure,
		type of hydrology:Tidal earth:Location named tidal_zone,
		level of ecology:NetPrimaryProduction named annual_net_primary_productivity_total,
		presence of earth:Coast with im:High earth:WindSpeed of earth:Storm named coastal_storms_exposure,
		presence of GBIF.SPECIES:4941589 ecology:Population named pinniped_colony
	lookup (altitude_zone, climate_zone, evapotranspiration, continentality, landcover, wave_energy, salt_exposure, tidal_zone, annual_net_primary_productivity_total, coastal_storms_exposure, pinniped_colony, ?)
	into BIOME_MT2_SUPRALITTORAL_COASTAL_ECOSYSTEM_TYPES;

//--- BIOME MT3 - AnthropogenicShoreline annotation---
model nca.ecosystem.iucn:AnthropogenicShoreline type of nca.ecosystem.iucn:Ecosystem named biome_mt3_anthropogenic_shoreline
	observing
		type of earth:ElevationZone named altitude_zone,
		landcover:LandCoverType named landcover,
		type of demography:SettlementDensity infrastructure:HumanSettlement named settlement_type,
		level of (earth:Littoral chemistry:Salinity) named salt_exposure,
		type of hydrology:Tidal earth:Location named tidal_zone
	lookup (altitude_zone, landcover, settlement_type, salt_exposure, tidal_zone, ?)
