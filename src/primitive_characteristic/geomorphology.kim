/* --- geomorphology_floodplain --- */
// primary_observations
// primary_observations for geomorphology_floodplain
model local:alessio.bulckaen:im.data.global:ecdc__geomorphology__floodplain__global__1900_2100
	as presence of hydrology:Floodplain named geomorphology_floodplain
	lookup (self, ?) into
		self | category
		---------------
		1    | true ,
		#    | false 
		;