/* --- climate_winter_water_budget_total --- */
// primary_observations
// primary_observations for climate_winter_water_budget_total
////Testing
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__winter_water_budget_total' 					as winter_water_budget_stac_dynamic_asset;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__winter_water_budget_total__global__1980_2010'	as winter_water_budget_stac_static_asset;
//number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.winter_water_budget_total_testing' 			as winter_water_budget_rb_testing;

model local:alessio.bulckaen:im.data.global:ecdc__climate__winter_water_budget_total__global__1980_2010
	as level of (hydrology:WaterVolume caused by hydrology:WaterBalance during earth:Winter) named climate_winter_water_budget_total
	lookup(self, ?) into
		self      | category         
		-----------------------------
		 <-500    | im:Low ,
	   -500 to 0  | im:ModeratelyLow ,
		0 to 1 	  |im:Moderate,
		1 to 500  | im:ModeratelyHigh,
		 >= 500   | im:High;

/* --- climate_winter_diurnal_air_temperature_mean --- */
// secondary_observations

////Testing
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__winter_diurnal_air_temperature_mean' 						as winter_diurnal_air_temperature_mean_stac_dynamic_asset;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__winter_diurnal_air_temperature_mean__global__1981_2010'	as winter_diurnal_air_temperature_mean_stac_static_asset;
//number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.winter_diurnal_air_temperature_mean_testing' 				as winter_diurnal_air_temperature_mean_rb_testing;
//number local:alessio.bulckaen:im.data.global:ecdc__climate__winter_diurnal_air_temperature_mean__global__1981_2010 		as winter_diurnal_air_temperature_mean_stac
//	set to [(self * 0.1) + (-273.15)];

// secondary_observations for climate_winter_diurnal_air_temperature_mean
// using STAC STATIC
model local:alessio.bulckaen:im.data.global:ecdc__climate__winter_diurnal_air_temperature_mean__global__1981_2010
	as im:Mean earth:AtmosphericTemperature during earth:Winter in Celsius named winter_diurnal_air_temperature_mean_input
	set to [(self * 0.1) + (-273.15)];

// primary_observations
// primary_observations for climate_winter_diurnal_air_temperature_mean
model level of im:Mean earth:AtmosphericTemperature during earth:Winter named climate_winter_diurnal_air_temperature_mean
	observing 
		im:Mean earth:AtmosphericTemperature during earth:Winter in Celsius named winter_diurnal_air_temperature_mean_input
	lookup (winter_diurnal_air_temperature_mean_input, ?) into
		winter_diurnal_air_temperature_mean_input | category                        
		----------------------------------------------------------------------------
		< -30                                     | ecology.incubation:ExtremelyCold ,
		-30 to -10                                | ecology.incubation:VeryCold ,
		-10 to 0                                  | ecology.incubation:Cold ,
		0 to 10                                   | ecology.incubation:Cool ,
		10 to 20                                  | ecology.incubation:Mild ,
		20 to 30                                  | ecology.incubation:Warm ,
		30 to 35                                  | ecology.incubation:Hot ,
		35 to 40                                  | ecology.incubation:VeryHot ,
		> 40                                      | ecology.incubation:ExtremelyHot 
		;




