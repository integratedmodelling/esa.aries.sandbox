/* --- climate_altitude_zone --- */
// primary_observations
// primary_observations for climate_altitude_zone

////Testing
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__altitude_zone' 					as altitude_zone_stac_dynamic_asset;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__altitude_zone_global_1981_2010'	as altitude_zone_stac_static_asset;
//number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.altitude_zone_testing' 			as altitude_zone_rb_testing;

// using STAC_STATIC
 model local:alessio.bulckaen:im.data.global:ecdc__climate__altitude_zone_global_1981_2010
	as type of earth:ElevationZone named climate_altitude_zone
	lookup (self, ?) into
		self | category       
		----------------------
		1    | earth:Nival ,
		2    | earth:Alpine ,
		3    | earth:Subalpine ,
		4    | earth:Montane ,
		5    | earth:Lowland ;


// primary_observations
// primary_observations for climate_annual_diurnal_air_temperature_mean
model level of im:Daily im:Mean earth:AtmosphericTemperature during im:Year named climate_annual_diurnal_air_temperature_mean
	observing 
		im:Daily im:Mean earth:AtmosphericTemperature during im:Year in Celsius named annual_diurnal_air_temperature_mean_input
	lookup (annual_diurnal_air_temperature_mean_input, ?) into
		annual_diurnal_air_temperature_mean_input | category                        
		----------------------------------------------------------------------------
		< -30                                     | ecology.incubation:ExtremelyCold ,
		-30 to -10                                | ecology.incubation:VeryCold ,
		-10 to 0                                  | ecology.incubation:Cold ,
		0 to 10                                   | ecology.incubation:Cool ,
		10 to 20                                  | ecology.incubation:Mild ,
		20 to 30                                  | ecology.incubation:Warm ,
		30 to 35                                  | ecology.incubation:Hot ,
		35 to 40                                  | ecology.incubation:VeryHot ,
		> 40                                      | ecology.incubation:ExtremelyHot 
		;

/* --- climate_annual_precipitation_total --- */
// primary_observations
// primary_observations for climate_annual_precipitation_total
//Testing
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__annual_precipitation_total' 					as annual_precipitation_stac_dynamic_asset;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__annual_precipitation_total__global__1981_2010'	as annual_precipitation_stac_static_asset;
//number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.annual_precipitation_total_testing' 			as annual_precipitation_rb_testing;

// using STAC STATIC
model local:alessio.bulckaen:im.data.global:ecdc__climate__annual_precipitation_total__global__1981_2010
	as level of im:Yearly earth:PrecipitationVolume named climate_annual_precipitation_total
	lookup (self, ?) into
		self        | category   
		-------------------------
		< 200       | im:VeryLow ,
		200 to 300  | im:Low ,
		300 to 900  | im:Moderate ,
		900 to 2000 | im:High ,
		> 2000      | im:VeryHigh 
		;
		
/* --- climate_annual_water_budget_total --- */
// primary_observations
// primary_observations for climate_annual_water_budget_total
////Testing
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__annual_water_budget_total' 					as annual_water_budget_stac_dynamic_asset;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__annual_water_budget_total__global__1981_2010'	as annual_water_budget_stac_static_asset;
//number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.annual_water_budget_total_testing' 			as annual_water_budget_rb_testing;

// using STAC STATIC
model local:alessio.bulckaen:im.data.global:ecdc__climate__annual_water_budget_total__global__1981_2010
	as level of (im:Yearly hydrology:WaterVolume caused by hydrology:WaterBalance) named climate_annual_water_budget_total
	lookup (self, ?) into
		self      | category         
		-----------------------------
		< -500    | im:Low ,
		-500 to 0 | im:ModeratelyLow ,
		0 to 0    | im:Moderate ,
		0 to 500  | im:ModeratelyHigh ,
		> 500     | im:High;


/* --- climate_climate_zone --- */
// primary_observations
// primary_observations for climate_climate_zone

////Testing
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__altitude_zone' 					as climate_zone_stac_dynamic_asset;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__climate_zone__global__2001_2020'	as climate_zone_stac_static_asset_2001_2020;
//number 'local:alessio.bulckaen:im.data.global:ecdc__climate__climate_zone_global_1981_2010'		as climate_zone_stac_static_asset_1981_2010;
//number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.altitude_zone_testing' 			as climate_zone_rb_testing;

// using GEOSERVER
model 
//	OLD VERSION: local:alessio.bulckaen:im.data.global:ecdc__climate__climate_zone__global__2001_2020,
	local:alessio.bulckaen:im.data.global:ecdc__climate__climate_zone_global_1981_2010
//	as type of earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_climate_zone
//	'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.altitude_zone_testing'
	as earth:Lowland type of nca.ecology.ipcc:ClimaticZone named climate_climate_zone
	lookup (self, ?) into
		self | category                      
		-------------------------------------
		1    | nca.ecology.ipcc:Polar ,
		2    | nca.ecology.ipcc:SubPolar ,
		3    | nca.ecology.ipcc:Boreal ,
		4    | nca.ecology.ipcc:ColdTemperate ,
		5    | nca.ecology.ipcc:WarmTemperate ,
		6    | nca.ecology.ipcc:SubTropical ,
		7    | nca.ecology.ipcc:Tropical ;


