//// Direct observation using 'self' for a continuous threshold
//model local:justus.muhando:esa.aries.sandbox:esa_weed_temp.geothermal_testing
//	as presence of earth:Crust physical:Thermal earth:Region with im:High im:Energy named energy_geothermal
//	lookup (self, ?) into
//		self     | category
//		---------------------------
//		  > 63   | true ,
//		0 to 62  | false ;
		
/* --- energy_geothermal --- */
// primary_observations
// primary_observations for energy_geothermal
model local:alessio.bulckaen:im.data.global:ecdc__energy__geothermal__global__2019
	as presence of earth:Crust physical:Thermal earth:Region with im:High im:Energy named energy_geothermal
	lookup (self, ?) into
		self    | category
		------------------
		> 63    | true ,
		0 to 62 | false 
		;		
		
