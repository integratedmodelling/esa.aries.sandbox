/* --- soil_fertility --- */
// primary_observations
// primary_observations for soil_fertility
model local:alessio.bulckaen:im.data.global:ecdc__soil__fertility__global__2001_2020
	as level of soil.incubation:Fertility named soil_fertility
	lookup (self, ?) into
		self                   | category   
		------------------------------------
		in (0 1 2 11 12 13 14) | im:None ,
		in (3 4)               | im:Low ,
		in (5 6 7)             | im:Moderate ,
		in (8 9 10)            | im:High 
		;




/* --- soil_physical_properties_bulk_density --- */
// primary_observations
// primary_observations for soil_physical_properties_bulk_density
model local:alessio.bulckaen:im.data.global:ecdc__soil__physical_properties_bulk_density__global__1995_2019
	as level of (ratio of earth:Dry soil:Soil im:Mass to soil:Soil im:Volume) named soil_physical_properties_bulk_density
	lookup (self, ?) into
		self   | category   
		--------------------
		0 to 0 | im:Low ,
		0 to 1 | im:Moderate ,
		> 1    | im:High 
		;




/* --- soil_chemical_properties_base_saturation --- */
// primary_observations
// primary_observations for soil_chemical_properties_base_saturation
model local:alessio.bulckaen:im.data.global:ecdc__soil__chemical_properties_base_saturation__global__1995_2019
	as level of (chemistry:Basic chemistry:ExchangeCapacity of chemistry:Cation) named soil_chemical_properties_base_saturation
	lookup (self, ?) into
		self      | category   
		-----------------------
		0 to 25   | im:VeryLow ,
		25 to 50  | im:Low ,
		50 to 70  | im:Moderate ,
		70 to 100 | im:High 
		;




/* --- soil_peat_thickness --- */
// primary_observations
// primary_observations for soil_peat_thickness
model local:alessio.bulckaen:im.data.global:ecdc__soil__peat_thickness__global__2001_2021
	as level of (im:Depth of landcover:PeatBog earth:Region) named soil_peat_thickness
	lookup (self, ?) into
		self    | category
		------------------
		0 to 0  | im:None ,
		1 to 29 | im:Low ,
		> 30    | im:High 
		;

		/* --- soil_chemical_properties_pH_status --- */
// primary_observations
// primary_observations for soil_chemical_properties_pH_status
model local:alessio.bulckaen:im.data.global:ecdc__soil__chemical_properties_ph_status__global__1995_2019
	as level of chemistry:Ph named soil_chemical_properties_ph_status
	lookup (self, ?) into
		self   | category                
		---------------------------------
		< 4    | chemistry:HighlyAcidic ,
		4 to 7 | chemistry:Acidic ,
		7 to 7 | chemistry:Neutral ,
		7 to 8 | chemistry:Alkaline ,
		> 8    | chemistry:HighlyAlkaline 
		;



/* --- soil_chemical_properties_N --- */
// secondary_observations

//number local:RESOURCE_MISSING_FOR_chemical_properties_N as chemical_properties_N_stac_wrong;
number 'local:alessio.bulckaen:im.data.global:ecdc__soil__chemical_properties_n__global__1995_2019' as chemical_properties_n_stac
	set to [(self * 0.1)];
number 'local:justus.muhando:esa.aries.sandbox:esa_weed_temp.chemical_properties_n_testing' as chemical_properties_n_rb_testing;
number chemical_properties_n_check
	observing chemical_properties_n_stac, chemical_properties_n_rb_testing
	set to [chemical_properties_n_stac - chemical_properties_n_rb_testing == 0 ? true : false];

// secondary_observations for soil_chemical_properties_N
//wrong model local:RESOURCE_MISSING_FOR_chemical_properties_N
model local:alessio.bulckaen:im.data.global:ecdc__soil__chemical_properties_n__global__1995_2019
	as proportion of chemistry:Nitrogen in soil:Soil named chemical_properties_n_input
	set to [(self * 0.1)];


// primary_observations
// primary_observations for soil_chemical_properties_N
model level of (proportion of chemistry:Nitrogen in soil:Soil) named soil_chemical_properties_n
	observing 
		proportion of chemistry:Nitrogen in soil:Soil named chemical_properties_n_input
	lookup (chemical_properties_n_input, ?) into
		chemical_properties_n_input | category   
		-----------------------------------------
				< 0.5               | im:VeryLow ,
				0.05 to 0.15        | im:Low ,
				0.15 to 0.2         | im:Moderate ,
				> 0.2               | im:High ;