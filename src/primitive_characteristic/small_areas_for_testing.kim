	nca.ecosystem.iucn:PermanentUplandStream   | #                                            | #                                                      | #                                                | #                                               | #                                                       | nca.ecosystem.iucn:PermanentUplandStream               ,
	#                                          | nca.ecosystem.iucn:CoastalSaltmarshReedbed   | #                                                      | #                                                | #                                               | #                                                       | nca.ecosystem.iucn:CoastalSaltmarshReedbed             ,
	#                                          | #                                            | nca.ecosystem.iucn:PermanentlyOpenRiverineEstuaryBay   | #                                                | #                                               | #                                                       | nca.ecosystem.iucn:PermanentlyOpenRiverineEstuaryBay   ,
	#                                          | #                                            | #                                                      | nca.ecosystem.iucn:UrbanIndustrialEcosystem      | #                                               | #                                                       | nca.ecosystem.iucn:UrbanIndustrialEcosystem            ,
	#                                          | #                                            | #                                                      | #                                                | nca.ecosystem.iucn:LargePermanentFreshwaterLake | #                                                       | nca.ecosystem.iucn:LargePermanentFreshwaterLake        ,
	#                                          | #                                            | #                                                      | #                                                | #                                               | nca.ecosystem.iucn:CoastalShrublandGrassland            | nca.ecosystem.iucn:CoastalShrublandGrassland
}};

model type of nca.ecosystem.iucn:Ecosystem named mapped_ecosystem_type_vietnam_testing_area_3
	observing
		nca.ecosystem.iucn:RiverStream type of nca.ecosystem.iucn:Ecosystem named biome_f1_river_stream,
		nca.ecosystem.iucn:BrackishTidal type of nca.ecosystem.iucn:Ecosystem named biome_mft1_brackish_tidal,
