 * # Result comparison between modelled ecosystem types & external rule-based reference maps (Level 3 Only).
 */
define IUCN_GET_LEVEL_CONSISTENCY_TABLE as {{
    modelled_ecosystem_type                                     | rule_based_external                                           | consistency
  ------------------------------------------------------------------------------------------------------------------------------------------------
    nca.ecosystem.iucn:PermanentUplandStream                    | nca.ecosystem.iucn:PermanentUplandStream                      | true,
    nca.ecosystem.iucn:PermanentLowlandStream                   | nca.ecosystem.iucn:PermanentLowlandStream                     | true,
    nca.ecosystem.iucn:FreezethawRiverStream                    | nca.ecosystem.iucn:FreezethawRiverStream                      | true,
    nca.ecosystem.iucn:SeasonalUplandStream                     | nca.ecosystem.iucn:SeasonalUplandStream                       | true,
