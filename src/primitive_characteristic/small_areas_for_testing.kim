// ==========================================
// AREA-SPECIFIC OPTIMIZED MODELS
// ==========================================
// ==========================================
// COLOMBIA TESTING AREA 1
// ==========================================
define COMBINED_BIOME_ECOSYSTEM_TABLE_COLOMBIA_TESTING_AREA_1 as {{
	biome_tf1_palustrine_wetland                              | biome_t1_tropical_subtropical_forest                      | biome_mft1_brackish_tidal                      | biome_fm1_semiconfined_transitional_water              | ecosystem_type_level3                                    
	---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	#                                                         | nca.ecosystem.iucn:TropicalSubtropicalLowlandRainforest   | #                                              | #                                                      | nca.ecosystem.iucn:TropicalSubtropicalLowlandRainforest   ,
    #                                                         |	#                                                         | nca.ecosystem.iucn:IntertidalForestShrubland   | #                                                      | nca.ecosystem.iucn:IntertidalForestShrubland              ,
    #                                                         |	#														  | nca.ecosystem.iucn:CoastalSaltmarshReedbed     | #                                                      | nca.ecosystem.iucn:CoastalSaltmarshReedbed                ,
    #                                                         |	#                                                         | #                                              | nca.ecosystem.iucn:PermanentlyOpenRiverineEstuaryBay   | nca.ecosystem.iucn:PermanentlyOpenRiverineEstuaryBay      ,
    nca.ecosystem.iucn:TropicalFloodedForestPeatForest        | #														  | #											   | #														| nca.ecosystem.iucn:TropicalFloodedForestPeatForest 
}};

model type of nca.ecosystem.iucn:Ecosystem named mapped_ecosystem_type_colombia_testing_area_1
	observing
		nca.ecosystem.iucn:TropicalSubtropicalForest type of nca.ecosystem.iucn:Ecosystem named biome_t1_tropical_subtropical_forest,
		nca.ecosystem.iucn:BrackishTidal type of nca.ecosystem.iucn:Ecosystem named biome_mft1_brackish_tidal,
		nca.ecosystem.iucn:SemiconfinedTransitionalWater type of nca.ecosystem.iucn:Ecosystem named biome_fm1_semiconfined_transitional_water,
		nca.ecosystem.iucn:PalustrineWetland type of nca.ecosystem.iucn:Ecosystem named biome_tf1_palustrine_wetland
	lookup (biome_t1_tropical_subtropical_forest, biome_mft1_brackish_tidal, biome_fm1_semiconfined_transitional_water, biome_tf1_palustrine_wetland, ?)
	into COMBINED_BIOME_ECOSYSTEM_TABLE_COLOMBIA_TESTING_AREA_1
	over space(urn='local:rubencc:esa.aries.sandbox:esa_weed_colombia_rb_testing_polygons#fid_id=1');

