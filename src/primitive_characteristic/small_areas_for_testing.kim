    nca.ecosystem.iucn:CanalDitchDrain                          | nca.ecosystem.iucn:CanalDitchDrain                            | true,
    nca.ecosystem.iucn:SeagrassMeadow                           | nca.ecosystem.iucn:SeagrassMeadow                             | true,
    nca.ecosystem.iucn:KelpForest                               | nca.ecosystem.iucn:KelpForest                                 | true,
    nca.ecosystem.iucn:PhoticCoralReef                          | nca.ecosystem.iucn:PhoticCoralReef                            | true,
    nca.ecosystem.iucn:ShellfishBedReef                         | nca.ecosystem.iucn:ShellfishBedReef                           | true,
