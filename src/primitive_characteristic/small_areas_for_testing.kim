    nca.ecosystem.iucn:EpisodicAridRiver                        | nca.ecosystem.iucn:EpisodicAridRiver                          | true,
    nca.ecosystem.iucn:LargeLowlandRiver                        | nca.ecosystem.iucn:LargeLowlandRiver                          | true,
    nca.ecosystem.iucn:LargePermanentFreshwaterLake             | nca.ecosystem.iucn:LargePermanentFreshwaterLake               | true,
    nca.ecosystem.iucn:SmallPermanentFreshwaterLake             | nca.ecosystem.iucn:SmallPermanentFreshwaterLake               | true,
    nca.ecosystem.iucn:SeasonalFreshwaterLake                   | nca.ecosystem.iucn:SeasonalFreshwaterLake                     | true,
    nca.ecosystem.iucn:FreezethawFreshwaterLake                 | nca.ecosystem.iucn:FreezethawFreshwaterLake                   | true,
    nca.ecosystem.iucn:EphemeralFreshwaterLake                  | nca.ecosystem.iucn:EphemeralFreshwaterLake                    | true,
    nca.ecosystem.iucn:PermanentSaltSodaLake                    | nca.ecosystem.iucn:PermanentSaltSodaLake                      | true,
    nca.ecosystem.iucn:EphemeralSaltLake                        | nca.ecosystem.iucn:EphemeralSaltLake                          | true,
    nca.ecosystem.iucn:ArtesianSpringOase                       | nca.ecosystem.iucn:ArtesianSpringOase                         | true,
    nca.ecosystem.iucn:GeothermalPoolWetland                    | nca.ecosystem.iucn:GeothermalPoolWetland                      | true,
    nca.ecosystem.iucn:SubglacialLake                           | nca.ecosystem.iucn:SubglacialLake                             | true,
    nca.ecosystem.iucn:LargeReservoir                           | nca.ecosystem.iucn:LargeReservoir                             | true,
