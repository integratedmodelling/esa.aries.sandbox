private namespace beta.ecosystem_type
using nca.ecosystem.eunis, nca.ecosystem.iucn, nca.ecosystem.naturalness, (IUCN_GET_NATURALNESS, ECOSYSTEM_NATURALNESS) from esa.aries.ecosystem.naturalness;

abstract attribute ModelApproach
	has children
		MachineLearning,
		RuleBased,
		HybridModelling;

abstract attribute ModelDataFlow
	has children
//		ConfidenceLevel,
		IntermediateOutput,
		Output;		



model 'local:alessio.bulckaen:esa.aries.sandbox:WEED_STAC_catalogue__EU_modelV2-1-MECE__EUNIS_level3_V2'
	as MachineLearning nca.ecosystem.eunis:EcosystemType named ecosystem_type_inference_eunis_level2_machine_learning_manual_annotation
