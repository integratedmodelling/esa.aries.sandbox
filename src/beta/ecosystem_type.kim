private namespace beta.ecosystem_type
using nca.ecosystem.eunis, nca.ecosystem.iucn, nca.ecosystem.naturalness, (IUCN_GET_NATURALNESS, ECOSYSTEM_NATURALNESS) from esa.aries.ecosystem.naturalness;

abstract attribute ModelApproach
	has children
		MachineLearning,
		RuleBased,
		HybridModelling;

abstract attribute ModelDataFlow
	has children
		IntermediateOutput,
		Output;

observe earth:Region named colombia_san_andres_co2  
    over space (urn = 'local:justus.muhando:esa.aries.sandbox:esa_weed_colombia_priority_areas_bbox_epsg4326_v2#weed_site=CO2',
    			grid="100 m",
                projection= "EPSG:4326"),
        time(start=2021, end=2025, step=1.year);
     
