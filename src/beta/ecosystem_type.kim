/**
 * Code for cell-wise comparison is quite ad-hoc and cryptic: the check responds true if
 * each evaluation (accumulating areas for all non-null values of the target) has the
 * target value in the row (at time init) changed into that of the column at the time
 * of evaluation. If the row and column describe the same concept and the cell target is
 * that concept, accumulate the unchanged, too.
 */
@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_rule_based_change_pairwise as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem type change matrix (km²)",
	when: end,
	target: beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	// compile ad-hoc pairwise change matrix on the target observable, also contabilizing nodata<->x transitions
	use: tables.compiler.pairwise(contabilize-nulls = true, compare = (start end), report = 'area', empty='0.00', no-data='0.00')
};

@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_machine_learning_change_pairwise as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem type change matrix (km²)",
