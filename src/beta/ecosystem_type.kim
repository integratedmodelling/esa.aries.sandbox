abstract attribute EcosystemNaturalness
	has children
		Natural,
		(Antrhpogenic
			has children
				SemiNatural);
				
model beta.ecosystem_type:MachineLearning beta.ecosystem_type:EcosystemNaturalness nca.ecosystem.eunis:EcosystemType named natural_ecosystem_extent_eunis_machine_learning
observing
	beta.ecosystem_type:MachineLearning nca.ecosystem.eunis:EcosystemType named ecosystem_type_eunis_level2_machine_learning
	lookup (ecosystem_type_eunis_level2_machine_learning,*, ?)
	into ECOSYSTEM_NATURALNESS; 


