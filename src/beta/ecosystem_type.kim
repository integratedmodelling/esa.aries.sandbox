model beta.ecosystem_type:RuleBased nca.ecosystem.naturalness:NaturalnessLevel named natural_ecosystem_extent_iucn_get_rule_based 	
observing
	beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get_level3_rule_based
	lookup (ecosystem_type_iucn_get_level3_rule_based, ?)
	into IUCN_GET_NATURALNESS;

@documented(global.ecosystemextent.natural_ecosystem_indicator)
define table natural_ecosystem_extent_iucn_get_static as {
	title: "Natural Ecosystem Extent"
	label: "Extent of natural ecosystems (km²) - Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF) derived from IUCN GET"
	target: beta.ecosystem_type:RuleBased nca.ecosystem.naturalness:NaturalnessLevel
	columns:({ title:  "{classifier}", target: im:Area in km^2, filter: beta.ecosystem_type:RuleBased nca.ecosystem.naturalness:NaturalnessLevel}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Area in {start} (km²)" })};
	
@documented(global.ecosystemextent.natural_ecosystem_indicator)	
@var(timespan=(start end))
define table natural_ecosystem_extent_iucn_get_rule_based_net_change as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - net balance (km²)",
	target: beta.ecosystem_type:RuleBased nca.ecosystem.naturalness:NaturalnessLevel
	when: end
	use: tables.compiler.summarize(contabilize-nulls = true, 
		rowsummary = { filter: "change" title: "Net change" style: bold}, 
		rows =       { filter: %timespan% }, 
		columns =    { filter: beta.ecosystem_type:RuleBased nca.ecosystem.naturalness:NaturalnessLevel }, 
		report='area', 
		empty='', 
		no-data = ''
	)
};
		
