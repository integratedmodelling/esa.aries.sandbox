/*
 * Table to summerize ecosystem type extent on a unique temporal observation
 */

define table ecosystem_typology_extent_iucn_get_rule_based_static as {
	title: "Selected ecosystem types (area in km²)",
	label: "Net change in ecosystem type (km²)",
	target: beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	columns:({ title:  "{classifier}", target: im:Area in km^2, filter: beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Area {start} (km²)" })}; 

