	as eunis_raster_code_classes;
	
number missing_classes 
observing
    nca.ecosystem.eunis:EcosystemType named ecosystem_type_eunis_level3,
    eunis_raster_code_classes
set to [ecosystem_type_eunis == unknown ? eunis_raster_code_classes : nodata];

/*
 * If both have NoData:
 * 
number missing_classes
observing
    nca.ecosystem.eunis:EcosystemType named ecosystem_type_eunis,
    eunis_raster_code_classes
set to [
    (ecosystem_type_eunis == unknown || ecosystem_type_eunis == nodata)
        ? eunis_raster_code_classes
        : nodata
		];
 * 
 */
