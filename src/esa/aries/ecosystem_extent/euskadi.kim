define table missing_eunis_classes_table as {
    title: "Unclassified EUNIS raster codes",
    label: "Area of missing EUNIS classes (km²)",
    target: missing_classes,
    columns: ({title:"{classifier}",target:im:Area in km^2,filter: missing_classes}
    		  {title:"Missing raster codes", summarize: sum, style: bold}
    ),
    rows: ({ title: "Area (km²)" })
};
