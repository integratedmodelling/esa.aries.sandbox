@colormap(colors=(red white green), midpoint=0)
define CONFIDENCE_LEVEL as {{
		  hybrid_model_probability  | confidence_level
		--------------------------------------------------
			     < 0.2	  			| im:VeryLow		,		
			  0.2 to 0.4	  		| im:Low			,
			  0.4 to 0.5 			| im:ModeratelyLow	,
		 	  0.5 to 0.6 			| im:Moderate		,
			  0.6 to  0.75			| im:ModeratelyHigh ,
			 0.75 to  0.9			| im:High 			,
				>= 0.9				| im:VeryHigh			
}};

	
