model 'local:liberentaizp:esa.aries.sandbox:esa_weed_temp.hm_top1_probability_mosaic'
	as type of esa.aries.model_approach:HybridFirstBest im:Level 
	lookup (self,?)
	into CONFIDENCE_LEVEL;
	
model 'local:caterina.gilli:im.aries.valencia:im_aries_valencia_valencia_vulnerability_by_barrio_4326_2021#ind_global'
	as type of risk:VulnerabilityMetric im:Level
	classified into
		im:Low if > 2.6,
		im:Moderate if 2.3 to 2.6,
		im:High if < 2.3
		;