project private namespace esa.aries.model_approach
	using nca.ecosystem.iucn;

abstract attribute ModelApproach
	has children
		MachineLearning,
		RuleBased,
		(Hybrid
		has children
		HybridFirstBest,
		HybridSecondBest,
		HybridThirdBest);
		
abstract attribute Status
	has children
		Finished,
		Computing,
		NotComputed;
		
define CONFIDENCE_LEVEL as {{
		  hybrid_model_probability  | confidence_level
		--------------------------------------------------
			     < 0.2	  			| im:VeryLow		,		
			  0.2 to 0.4	  		| im:Low			,
			  0.4 to 0.5 			| im:ModeratelyLow	,
		 	  0.5 to 0.6 			| im:Moderate		,
			  0.6 to  0.75			| im:ModeratelyHigh ,
			 0.75 to  0.9			| im:High 			,
				>= 0.9				| im:VeryHigh			
}};





model each 'local:alessio.bulckaen:esa.aries.sandbox:RuleBased-V502_items_completed'
	as esa.aries.model_approach:Finished esa.aries.model_approach:RuleBased earth:Region;
model each 'local:alessio.bulckaen:esa.aries.sandbox:weed:RuleBased-V502-jobdb'
	as esa.aries.model_approach:RuleBased earth:Region;
	
model 'local:alessio.bulckaen:esa.aries.sandbox:RuleBased-V502_items_completed'
	as esa.aries.model_approach:Finished esa.aries.model_approach:RuleBased earth:Region;	

	