private namespace esa.aries.rule_based_accuracy
using nca.ecosystem.iucn, et_result_comparison,
(IUCN_GET_LEVEL_CONVERSION_TABLE) from et_result_comparison,
(IUCN_GET_LEVEL_CONSISTENCY_TABLE) from et_result_comparison;

/* The reference model has to be written to pick the best data available */

model 'local:alessio.bulckaen:esa.aries.sandbox:weed_validation#getraster'
	as im:Reference type of nca.ecosystem.iucn:Ecosystem 
	classified according to im:ecosystem-get-iucn;

observe earth:Region named colombia_iucnget_rb_v502
        over space(shape='EPSG:4326 POLYGON ((-74.63689662931095 8.141871773271133, -74.63673180952716 8.322777136134407, -74.81836496706067 8.322901657560594, -74.81844737903323 8.141993552342004, -74.63689662931095 8.141871773271133))',
                grid = "30 m"),
        time (year=2024);
observe earth:Region named small_area_test_colombia
        over space(shape='EPSG:4326 POLYGON ((-74.72446240398484 8.201517351065604, -74.72510858022173 8.198302015418747, -74.7269487344579 8.195576165115554, -74.729702719892 8.193754799763099, -74.73295126720657 8.193115219326899, -74.73619981452114 8.193754799763099, -74.73895379995521 8.195576165115554, -74.7407939541914 8.198302015418747, -74.74144013042829 8.201517351065604, -74.7407939541914 8.204732660706199, -74.73895379995521 8.207458448224614, -74.73619981452114 8.209279750792305, -74.73295126720657 8.2099193052222, -74.729702719892 8.209279750792305, -74.7269487344579 8.207458448224614, -74.72510858022173 8.204732660706199, -74.72446240398484 8.201517351065604))',
                grid = "30 m"),
        time (year=2024);
        
/*IUCN GET RuleBased */
//model 'local:alessio.bulckaen:esa.aries.sandbox:WEED-RB-IUCNGET_mece-cube_year2024_18λWQ33_V502_2024-01-01Z' 
model 'local:alessio.bulckaen:esa.aries.sandbox:RuleBased-V502'
as type of nca.ecosystem.iucn:Ecosystem
classified according to im:ecosystem-get-iucn;

/* -----------------------------------------------------------------------------------------------------------------------------------------------
