/* IUCN GET RuleBased results */
model esa.aries.model_approach:RuleBased nca.ecosystem.naturalness:NaturalnessLevel named natural_ecosystem_extent_iucn_get_rule_based 	
observing
	esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get_level3_rule_based
	lookup (ecosystem_type_iucn_get_level3_rule_based, ?)
	into IUCN_GET_NATURALNESS;

@documented(global.ecosystemextent.natural_ecosystem_indicator)
define table gbf_indicator_a2_natural_ecosystem_percentage_iucn_get__rule_based_static as {

	title: "Natural ecosystem extent (%) - Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF) - RuleBased results"
	label: "Natural Ecosystem Extent"

	target: esa.aries.model_approach:RuleBased nca.ecosystem.naturalness:NaturalnessLevel

	columns: (
		{title: "Natural ecosystem extent (km²)", target: im:Area in km^2, filter: esa.aries.model_approach:RuleBased nca.ecosystem.naturalness:NaturalnessLevel, keep: (any nca.ecosystem.naturalness:Natural)}
		{title: "Anthropogenic ecosystem extent (km²)", target: im:Area in km^2, filter: esa.aries.model_approach:RuleBased nca.ecosystem.naturalness:NaturalnessLevel, keep: (any nca.ecosystem.naturalness:Anthropogenic)}
		{title: "Total ecosystem extent (km²)", summarize: [c1 + c2], style: bold}
		{title: "Natural ecosystem extent (%)", summarize: [(c1 / (c1 + c2)) * 100],style: bold}
	)

	rows: ({title: "Year {start}"})
};
	

