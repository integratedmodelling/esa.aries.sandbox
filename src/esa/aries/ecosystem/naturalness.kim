@documented(global.ecosystemextent.natural_ecosystem_indicator)
define table gbf_indicator_a2_natural_ecosystem_extent_iucn_get_by_biome_machine_learning as {

    title: "Percentage of natural ecosystem extent by biome (Level 2 IUCN) - GBF Indicator A.2 - Machine Learning results"
    label: "Natural Ecosystem Percentage by IUCN Biome"
    

    target: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType

    columns: (
        {
            title: "Natural (km²)"
            target: im:Area in km^2
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.naturalness:NaturalnessLevel
            keep: (any nca.ecosystem.naturalness:Natural)
        }

        {
            title: "Anthropogenic (km²)"
            target: im:Area in km^2
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.naturalness:NaturalnessLevel
            keep: (any nca.ecosystem.naturalness:Anthropogenic)
        }

        {
            title: "Total (km²)"
            summarize: [c1 + c2]
            style: bold
        }

        {
            title: "Natural ecosystem (%)"
            summarize: [(c1 / (c1 + c2)) * 100]
            style: bold
        }
    )

rows: (
    {
        title: "{classifier}"
        filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
        keep: (
            any nca.ecosystem.iucn:TropicalSubtropicalForest,
            any nca.ecosystem.iucn:TemperateBorealForestWoodland,
            any nca.ecosystem.iucn:ShrublandShrubbyWoodland,
            any nca.ecosystem.iucn:SavannaGrassland,
            any nca.ecosystem.iucn:DesertSemidesert,
            any nca.ecosystem.iucn:IntensiveLandUseSystem,
            any nca.ecosystem.iucn:PolarAlpine,
            any nca.ecosystem.iucn:RiverStream,
            any nca.ecosystem.iucn:Lake,
            any nca.ecosystem.iucn:ArtificialWetland,
            any nca.ecosystem.iucn:AnthropogenicMarine,
            any nca.ecosystem.iucn:SemiconfinedTransitionalWater,
            any nca.ecosystem.iucn:Shoreline,
            any nca.ecosystem.iucn:SupralittoralCoastal,
            any nca.ecosystem.iucn:AnthropogenicShoreline,
            any nca.ecosystem.iucn:PalustrineWetland,
            any nca.ecosystem.iucn:BrackishTidal

        )
    }
)
};

@documented(global.ecosystemextent.natural_ecosystem_indicator)
define table gbf_indicator_a2_natural_ecosystem_extent_iucn_get_by_realm_iucn_machine_learning as {

    title: "Percentage of natural ecosystem extent by realm (Level 1 IUCN) - GBF Indicator A.2 - Machine Learning results"
	label: "Natural Ecosystem Extent by IUCN Realm"
    
    target: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType

    columns: (
        {
            title: "Natural (km²)"
            target: im:Area in km^2
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.naturalness:NaturalnessLevel
            keep: (any nca.ecosystem.naturalness:Natural)
        }

        {
            title: "Anthropogenic (km²)"
            target: im:Area in km^2
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.naturalness:NaturalnessLevel
            keep: (any nca.ecosystem.naturalness:Anthropogenic)
        }

        {
            title: "Total (km²)"
            summarize: [c1 + c2]
            style: bold
        }

        {
            title: "Natural ecosystem (%)"
            summarize: [(c1 / (c1 + c2)) * 100]
            style: bold
        }
    )

    rows: (
        {
            title: "Terrestrial"
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
            keep: (any nca.ecosystem.iucn:Terrestrial)
        }

        {
            title: "Freshwater"
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
            keep: (any nca.ecosystem.iucn:Freshwater)
        }
        
        {
            title: "Freshwater/Marine"
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
            keep: (any nca.ecosystem.iucn:FreshwaterMarine)
        }

        {
            title: "Marine/Terrestrial"
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
            keep: (any nca.ecosystem.iucn:MarineTerrestrial)
        }

        {
            title: "Terrestrial/Freshwater"
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
            keep: (any nca.ecosystem.iucn:TerrestrialFreshwater)
        }

        {
            title: "Marine/Freshwater/Terrestrial"
            filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
            keep: (any nca.ecosystem.iucn:MarineFreshwaterTerrestrial)
        }

    )
};




/*
 * ***********************************************************************************************************
 */

/* EUNIS Machine Learning results */
model nca.ecosystem.naturalness:NaturalnessLevel named eunis_natural_ecosystem_extent
observing
	esa.aries.model_approach:MachineLearning nca.ecosystem.eunis:EcosystemType named eunis
	lookup (eunis, ?)
	into EUNIS_ECOSYSTEM_NATURALNESS; 

define table natural_ecosystem_extent_eunis as {
	title: "Natural Ecosystem Extent"
	label: "Extent of natural ecosystems (km²) - Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF) derived from EUNIS"
	target: nca.ecosystem.naturalness:NaturalnessLevel
	columns:({ title:  "{classifier}", target: im:Area in km^2, filter: nca.ecosystem.naturalness:NaturalnessLevel}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Area {start} (km²)" })};
	