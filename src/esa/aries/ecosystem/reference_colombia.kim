  esa.aries.ecosystem.reference_colombia:CoastalLagoon                              | nca.ecosystem.iucn:CoastalRiverDelta                    ,
  esa.aries.ecosystem.reference_colombia:CoastalSwampyArea                          | nca.ecosystem.iucn:MuddyShoreline                       ,
  esa.aries.ecosystem.reference_colombia:Paramo                                     | nca.ecosystem.iucn:TropicalAlpineGrasslandShrubland     ,
