private namespace esa.aries.ecosystem.reference
using nca.ecosystem.iucn;


/* Global validation point */
model 'local:alessio.bulckaen:esa.aries.sandbox:weed_validation#getraster'
	as im:Reference type of nca.ecosystem.iucn:Ecosystem named global_validation_points
	classified according to im:ecosystem-get-iucn;

/* Czech map  */
model 'local:alessio.bulckaen:esa.aries.sandbox:esa_weed.czechrepublic_validation_ecosystems_epsg5514_10m'
as geography:CzechRepublic im:Reference type of nca.ecosystem.iucn:Ecosystem named reference_ecosystem_czech_republic 
		classified into 
		nca.ecosystem.iucn:DeciduousTemperateForest if 10202,
		nca.ecosystem.iucn:SeasonalFloodplainMarsh if 50104,
		nca.ecosystem.iucn:EpisodicAridFloodplain if 60141,
		nca.ecosystem.iucn:DerivedSeminaturalPastureOldfield if 10705,
		nca.ecosystem.iucn:BorealTemperateFen if 50107,
		nca.ecosystem.iucn:TemperateAlpineGrasslandShrubland if 10604,
		nca.ecosystem.iucn:TemperateSubhumidGrassland if 10405,
		nca.ecosystem.iucn:PolarTundraDesert if 10603,
		nca.ecosystem.iucn:AnnualCropland if 10701,
		nca.ecosystem.iucn:UrbanIndustrialEcosystem if 10704,
		nca.ecosystem.iucn:Plantation if 10703,
		nca.ecosystem.iucn:SownPastureField if 10702,
		nca.ecosystem.iucn:BorealTemperateMontaneForestWoodland if 10201,
		nca.ecosystem.iucn:CoolTemperateHeathland if 10303,
		nca.ecosystem.iucn:LargePermanentFreshwaterLake if 60201,
		nca.ecosystem.iucn:SmallPermanentFreshwaterLake if 60202;
/* Model as im:Reference type of nca.ecosystem.iucn:Ecosystem to use the best reference data for the model run */

model 'local:alessio.bulckaen:esa.aries.sandbox:weed_validation#getraster'
	as im:Reference type of nca.ecosystem.iucn:Ecosystem 
	classified according to im:ecosystem-get-iucn;	


