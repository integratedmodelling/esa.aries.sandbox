private namespace esa.aries.ecosystem.reference
using nca.ecosystem.iucn, nca.ecosystem.eunis,
(CROSSWALK_COLOMBIA_NATIONAL_CLASSIFICATION_TO_IUCN_GET) from rule_based_modelling.colombia;


/* Global validation point */
model 'local:alessio.bulckaen:esa.aries.sandbox:weed_validation#getraster'
	as im:Reference type of nca.ecosystem.iucn:Ecosystem named global_validation_data_iucn_get
	classified according to im:ecosystem-get-iucn;

model 'local:alessio.bulckaen:esa.aries.sandbox:weed_validation#eunisraster'
	as im:Reference type of nca.ecosystem.iucn:Ecosystem named global_validation_data_eunis
	classified into
		nca.ecosystem.eunis:MarineBenthicHabitats if 10000,
		nca.ecosystem.eunis:LittoralRock if in (10100, 10101, 10102, 10103, 10104, 10105),
		nca.ecosystem.eunis:LittoralBiogenicHabitat if in (10200 10201 10202 10203 10204 10205),
