/**
 * High-level summary table with expansions and regressions as per 
 * https://seea.un.org/sites/seea.un.org/files/documents/EEA/2_seea_eea_rev._ch4_gc_mar2020_final.pdf.
 * Missing categorization into managed/natural and reappraisals for lack of source info.
 * TODO add phys env traits and metadata to classification for grouping and labeling
 */
@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_rule_based_additions_reductions as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - additions and reductions (km²)",
	target: esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType
	when: end,
	use: tables.compiler.additionsreductions(contabilize-nulls = true, compare = (start end), report = 'area', empty='', no-data='')
};

@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_machine_learning_additions_reductions as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - additions and reductions (km²)",
	target: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
	when: end,
	use: tables.compiler.additionsreductions(contabilize-nulls = true, compare = (start end), report = 'area', empty='', no-data='')
};

@var(timespan=(start end))
define table ecosystem_typology_extent_eunis_machine_learning_additions_reductions as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - additions and reductions (km²)",
	target: esa.aries.model_approach:MachineLearning nca.ecosystem.eunis:EcosystemType
	when: end,
	use: tables.compiler.additionsreductions(contabilize-nulls = true, compare = (start end), report = 'area', empty='', no-data='')
};

/**
 * Code for cell-wise comparison is quite ad-hoc and cryptic: the check responds true if
 * each evaluation (accumulating areas for all non-null values of the target) has the
 * target value in the row (at time init) changed into that of the column at the time
 * of evaluation. If the row and column describe the same concept and the cell target is
 * that concept, accumulate the unchanged, too.
 */
@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_rule_based_change_pairwise as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem type change matrix (km²)",
	when: end,
	target: esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType
	// compile ad-hoc pairwise change matrix on the target observable, also contabilizing nodata<->x transitions
	use: tables.compiler.pairwise(contabilize-nulls = true, compare = (start end), report = 'area', empty='0.00', no-data='0.00')
};

@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_machine_learning_change_pairwise as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem type change matrix (km²)",
	when: end,
	target: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
	// compile ad-hoc pairwise change matrix on the target observable, also contabilizing nodata<->x transitions
	use: tables.compiler.pairwise(contabilize-nulls = true, compare = (start end), report = 'area', empty='0.00', no-data='0.00')
};

@var(timespan=(start end))
define table ecosystem_typology_extent_eunis_machine_learning_change_pairwise as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem type change matrix (km²)",
	when: end,
	target: esa.aries.model_approach:MachineLearning nca.ecosystem.eunis:EcosystemType
	// compile ad-hoc pairwise change matrix on the target observable, also contabilizing nodata<->x transitions
	use: tables.compiler.pairwise(contabilize-nulls = true, compare = (start end), report = 'area', empty='0.00', no-data='0.00')
};
/*
 * Table to summerize ecosystem type extent on a unique temporal observation
 */

define table ecosystem_typology_extent_iucn_get_rule_based_static as {
	title: "Selected ecosystem types (area in km²)",
	label: "Net change in ecosystem type (km²)",
	target: esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType
	columns:({ title:  "{classifier}", target: im:Area in km^2, filter: esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Area {start} (km²)" })};
	
