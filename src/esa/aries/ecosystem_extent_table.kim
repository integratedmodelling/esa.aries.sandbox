private namespace esa.aries.ecosystem_extent_table
using esa.aries.model_approach, nca.ecosystem.iucn, nca.ecosystem.eunis;

/*
 * Simplest extent table has a column for each represented ecosystem type and
 * the total area for each of the first and last year, plus a net change row.
 */
@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_rule_based_basic as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - net balance (km²)",
	target: esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType
	when: end
	use: tables.compiler.summarize(contabilize-nulls = true, 
		rowsummary = { filter: "change" title: "Net change" style: bold}, 
		rows =       { filter: %timespan% }, 
		columns =    { filter: esa.aries.model_approach:RuleBased nca.ecosystem.iucn:EcosystemType }, 
		report='area', 
		empty='', 
		no-data = ''
	)
};

@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_machine_learning_basic as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - net balance (km²)",
	target: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType
	when: end
	use: tables.compiler.summarize(contabilize-nulls = true, 
		rowsummary = { filter: "change" title: "Net change" style: bold}, 
		rows =       { filter: %timespan% }, 
		columns =    { filter: esa.aries.model_approach:MachineLearning nca.ecosystem.iucn:EcosystemType }, 
		report='area', 
		empty='', 
		no-data = ''
	)
};

@var(timespan=(start end))
define table ecosystem_typology_extent_eunis_machine_learning_basic as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - net balance (km²)",
	target: esa.aries.model_approach:MachineLearning nca.ecosystem.eunis:EcosystemType
	when: end
	use: tables.compiler.summarize(contabilize-nulls = true, 
		rowsummary = { filter: "change" title: "Net change" style: bold}, 
		rows =       { filter: %timespan% }, 
		columns =    { filter: esa.aries.model_approach:MachineLearning nca.ecosystem.eunis:EcosystemType }, 
		report='area', 
		empty='', 
		no-data = ''
