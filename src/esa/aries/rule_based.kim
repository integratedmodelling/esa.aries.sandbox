private namespace esa.aries.rule_based
using nca.ecosystem.iucn,
(IUCN_GET_NATURALNESS) from esa.aries.ecosystem.naturalness;

@documented(global.ecosystemextent.rulebased_mapping)
model 
'local:alessio.bulckaen:esa.aries.sandbox:WEED_rule_based_IUCN_GET'
	as nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get_level3_rule_based
	classified according to im:ecosystem-get-iucn;

/*
 * Simplest extent table has a column for each represented ecosystem type and
 * the total area for each of the first and last year, plus a net change row.
 */
@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_rule_based_basic as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - net balance (km²)",
	target: nca.ecosystem.iucn:EcosystemType//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	when: end
	use: tables.compiler.summarize(contabilize-nulls = true, 
		rowsummary = { filter: "change" title: "Net change" style: bold}, 
		rows =       { filter: %timespan% }, 
		columns =    { filter: nca.ecosystem.iucn:EcosystemType},//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType }, 
		report='area', 
		empty='', 
		no-data = ''
	)
};

/**
 * High-level summary table with expansions and regressions as per 
 * https://seea.un.org/sites/seea.un.org/files/documents/EEA/2_seea_eea_rev._ch4_gc_mar2020_final.pdf.
 * Missing categorization into managed/natural and reappraisals for lack of source info.
 * TODO add phys env traits and metadata to classification for grouping and labeling
 */
@var(timespan=(start end))
define table ecosystem_typology_extent_iucn_get_rule_based_additions_reductions as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - additions and reductions (km²)",
	target: nca.ecosystem.iucn:EcosystemType//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	when: end,
	use: tables.compiler.additionsreductions(contabilize-nulls = true, compare = (start end), report = 'area', empty='', no-data='')
};

/*
 * Table to summerize ecosystem type extent on a unique temporal observation
 */

define table ecosystem_typology_extent_iucn_get_rule_based_static as {
	title: "Selected ecosystem types (area in km²)",
	label: "Net change in ecosystem type (km²)",
	target: nca.ecosystem.iucn:EcosystemType//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	columns:({ title:  "{classifier}", target: im:Area in km^2, filter: nca.ecosystem.iucn:EcosystemType}//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Area {start} (km²)" })}; 

	
model nca.ecosystem.iucn:EcosystemType named natural_ecosystem_extent_iucn_get_rule_based //beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType 	
observing
	nca.ecosystem.iucn:EcosystemType named ecosystem_type_iucn_get_level3_rule_based //beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	lookup (ecosystem_type_iucn_get_level3_rule_based, ?)
	into IUCN_GET_NATURALNESS;

@documented(global.ecosystemextent.natural_ecosystem_indicator)
define table natural_ecosystem_extent_iucn_get_static as {
	title: "Natural Ecosystem Extent"
	label: "Extent of natural ecosystems (km²) - Headline Indicator A.2 of the Kunming-Montreal Global Biodiversity Framework (GBF) derived from IUCN GET"
	target: nca.ecosystem.iucn:EcosystemType//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	columns:({ title:  "{classifier}", target: im:Area in km^2, filter:nca.ecosystem.iucn:EcosystemType}//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType}
			 {title: "Total", summarize: sum, style: bold}),
	rows:   ({ title: "Area in {start} (km²)" })};
	
@documented(global.ecosystemextent.natural_ecosystem_indicator)	
@var(timespan=(start end))
define table natural_ecosystem_extent_iucn_get_rule_based_net_change as {
	name: "ecosystem_extent"
	title: "Occurring ecosystem types (selected level 3 Ecosystem Functional Groups of the IUCN Global Ecosystem Typology 2.0)",
	label: "Ecosystem extent account - net balance (km²)",
	target: nca.ecosystem.iucn:EcosystemType//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType
	when: end
	use: tables.compiler.summarize(contabilize-nulls = true, 
		rowsummary = { filter: "change" title: "Net change" style: bold}, 
		rows =       { filter: %timespan% }, 
		columns =    { filter: nca.ecosystem.iucn:EcosystemType},//beta.ecosystem_type:RuleBased nca.ecosystem.iucn:EcosystemType}, 
		report='area', 
		empty='', 
		no-data = ''
	)
};	