  // TF1.2 arid/semi-arid peat support.
  # | # | in (earth:Lowland, earth:Montane) | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical) | in (ecology:Arid, ecology:SemiArid) | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | in (ecology:Open, ecology:Dense) | # | # | # | # | # | # | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

  // Final TF1.2 fallback. It is intentionally last because several R hard variables are unavailable in k.LAB.
  # | # | in (earth:Lowland, earth:Montane) | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical) | # | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | in (ecology:Open, ecology:Dense) | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland
}};


model nca.ecosystem.iucn:PalustrineWetland
    type of nca.ecosystem.iucn:Ecosystem
    named biome_tf1_palustrine_wetland

    observing
        type of hydrology:WaterBody
            named waterbody_type,

        type of hydrology:WaterPermanence
            named water_permanence_type,

        type of earth:ElevationZone
            named altitude_zone,

        type of nca.ecology.ipcc:ClimaticZone
            named climate_zone,

        type of ecology:MoistureRegime
            named evapotranspiration,

        landcover:LandCoverType
            named landcover,

        level of im:Mean earth:AtmosphericTemperature during earth:Summer
            named summer_diurnal_air_temperature_mean,

        type of hydrology:WaterSource
            named dominant_source,

        level of (chemistry:Basic chemistry:ExchangeCapacity of chemistry:Cation)
            named chemical_properties_base_saturation,

        level of chemistry:Ph
            named chemical_properties_ph_status,

        presence of hydrology:Floodplain
            named floodplain,

        level of ecology:NetPrimaryProduction
            named annual_net_primary_productivity_total,

        level of im:Yearly earth:PrecipitationVolume
            named annual_precipitation_total,

        level of (im:Mean im:Height of ecology:Canopy)
            named canopy_height,

        level of ecology:CanopyCover
            named canopy_cover,

        level of ecology:LeafAreaIndex
            named leaf_area_index,

        type of ecology:LeafPhenology
            named phenology,

        level of (ratio of im:Area to earth:Dry im:Mass of biology:Leaf)
            named specific_leaf_area,

        level of (physical.incubation:Shadow im:Area of biology:Leaf)
            named leaf_size,

        level of (im:Yearly hydrology:WaterVolume caused by hydrology:WaterBalance)
            named annual_water_budget_total,

        level of (risk:HazardMetric probability of chemistry:Fire)
            named exposure,

        level of im:Mean im:Changed
            primitive_characteristic.climate:SeasonalAmplitude
            earth:AtmosphericTemperature
            named seasonal_diurnal_air_temperature_variability,

        level of (im:Depth of landcover:PeatBog earth:Region)
            named peat_thickness

    lookup (
        waterbody_type,
        water_permanence_type,
        altitude_zone,
        climate_zone,
        evapotranspiration,
        landcover,
        summer_diurnal_air_temperature_mean,
        dominant_source,
        chemical_properties_base_saturation,
        chemical_properties_ph_status,
        floodplain,
        annual_net_primary_productivity_total,
        annual_precipitation_total,
        canopy_height,
        canopy_cover,
        leaf_area_index,
        phenology,
        specific_leaf_area,
        leaf_size,
        annual_water_budget_total,
        exposure,
        seasonal_diurnal_air_temperature_variability,
        peat_thickness,
        ?
    )
    into BIOME_TF1_PALUSTRINE_WETLAND_ECOSYSTEM_TYPES;

