private namespace biome_tfone_palustrine_wetland_rcodeaprox
using nca.ecosystem.iucn, nca.ecology.ipcc,
primitive_characteristic.climate;  

//Observe canopy cover and height and LAI first, switched LAI to Geoserver resource because took too long 

/*
 * TF1 palustrine-wetland lookup approximating the R rule engine.
 *
 * Row order is significant: the first matching row wins.
 * Weight-1 conditions from the R branches are retained where an existing
 * k.LAB dependency can express them. Lower rows relax only lower-weight
 * evidence, or provide a documented proxy where the R dependency is absent.
 *
 */

define BIOME_TF1_PALUSTRINE_WETLAND_ECOSYSTEM_TYPES as {{
  waterbody_type | water_permanence_type | altitude_zone | climate_zone | evapotranspiration | landcover | summer_diurnal_air_temperature_mean | dominant_source | chemical_properties_base_saturation | chemical_properties_ph_status | floodplain | annual_net_primary_productivity_total | annual_precipitation_total | canopy_height | canopy_cover | leaf_area_index | phenology | specific_leaf_area | leaf_size | annual_water_budget_total | exposure | seasonal_diurnal_air_temperature_variability | peat_thickness | ecosystem_type
  --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  // TF1.1 — Tropical flooded forest/peat forest: ombrotrophic deep-peat branch, fully supported.
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | # | in (im:High, im:VeryHigh) | # | ecology:Dense | in (im:High, im:VeryHigh) | ecology:Evergreen | in (im:ModeratelyLow, im:ModeratelyHigh) | in (ecology:Notophyll, ecology:Mesophyll) | # | # | in (im:VeryLow, im:Low) | im:High | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // Same hard branch, relaxing canopy, LAI, SLA and leaf-size evidence (all weight 0.9).
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | # | in (im:High, im:VeryHigh) | # | # | # | ecology:Evergreen | # | # | # | # | in (im:VeryLow, im:Low) | im:High | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // Operational fallback for unavailable peat thickness. This deliberately relaxes the R branch's hard deep-peat condition.
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | # | in (im:High, im:VeryHigh) | # | # | # | ecology:Evergreen | # | # | # | # | in (im:VeryLow, im:Low) | # | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // Lower-priority operational fallback for high seasonal temperature variability and unavailable peat thickness.
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | # | in (im:High, im:VeryHigh) | # | # | # | ecology:Evergreen | # | # | # | # | im:High | # | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // Lower-priority extension of the preceding fallback allowing high base saturation.
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:High | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | # | in (im:High, im:VeryHigh) | # | # | # | ecology:Evergreen | # | # | # | # | im:High | # | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // TF1.1 floodplain/base-rich branch, fully supported.
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | # | in (im:Moderate, im:High) | # | true | # | in (im:High, im:VeryHigh) | # | ecology:Dense | in (im:High, im:VeryHigh) | ecology:Evergreen | in (im:ModeratelyLow, im:ModeratelyHigh) | in (ecology:Notophyll, ecology:Mesophyll) | # | # | in (im:VeryLow, im:Low) | # | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // Same hard branch with soft vegetation evidence relaxed.
  # | # | earth:Lowland | nca.ecology.ipcc:Tropical | # | in (landcover:Forest, landcover:Shrubland) | # | # | in (im:Moderate, im:High) | # | true | # | in (im:High, im:VeryHigh) | # | # | # | ecology:Evergreen | # | # | # | # | in (im:VeryLow, im:Low) | # | nca.ecosystem.iucn:TropicalFloodedForestPeatForest ,

  // TF1.5 — Episodic arid floodplain. All represented conditions are hard.
  # | hydrology:Episodic | # | # | in (ecology:Arid, ecology:SemiArid) | in (landcover:Grassland, landcover:Wetland) | in (ecology.incubation:Hot, ecology.incubation:VeryHot) | # | # | # | true | im:Low | # | # | # | # | # | # | # | im:Low | # | # | # | nca.ecosystem.iucn:EpisodicAridFloodplain ,

  // TF1.3 — Permanent marsh with soft NPP and fire support.
  # | hydrology:Permanent | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | # | in (landcover:Grassland, landcover:Wetland) | # | # | # | # | # | im:High | # | # | # | # | # | # | # | # | in (im:None, im:Low) | # | # | nca.ecosystem.iucn:PermanentMarsh ,

  // TF1.3 hard-core fallback: NPP and fire exposure are weight 0.9.
  # | hydrology:Permanent | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | # | in (landcover:Grassland, landcover:Wetland) | # | # | # | # | # | # | # | # | # | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:PermanentMarsh ,

  // TF1.4 — Seasonal herbaceous floodplain, with soft NPP/fire support.
  # | hydrology:Seasonal | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Grassland, landcover:Wetland) | # | # | # | # | true | im:High | # | # | # | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // TF1.4 seasonal herbaceous hard-core fallback.
  # | hydrology:Seasonal | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Grassland, landcover:Wetland) | # | # | # | # | true | # | # | # | # | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // TF1.4 seasonal woody floodplain, with soft NPP/fire support.
  # | hydrology:Seasonal | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | true | im:High | # | in (im:VeryLow, im:Low, im:Moderate) | ecology:Open | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // TF1.4 seasonal woody hard-core fallback.
  # | hydrology:Seasonal | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | true | # | # | in (im:VeryLow, im:Low, im:Moderate) | ecology:Open | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // TF1.4 ephemeral branch approximated by the available Episodic classifier.
  # | hydrology:Episodic | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Grassland, landcover:Wetland) | # | # | in (im:Moderate, im:High) | # | true | im:High | # | # | # | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // Same episodic proxy with lower-weight NPP, base saturation and fire relaxed.
  # | hydrology:Episodic | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Grassland, landcover:Wetland) | # | # | # | # | true | # | # | # | # | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // Woody episodic proxy; structural conditions remain hard.
  # | hydrology:Episodic | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Forest, landcover:Shrubland) | # | # | in (im:Moderate, im:High) | # | true | im:High | # | in (im:VeryLow, im:Low, im:Moderate) | ecology:Open | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // Woody episodic proxy with soft evidence relaxed.
  # | hydrology:Episodic | # | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | ecology:SubHumid | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | true | # | # | in (im:VeryLow, im:Low, im:Moderate) | ecology:Open | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SeasonalFloodplainMarsh ,

  // TF1.6 — Boreal/subpolar non-woody peat bog, fully supported.
  # | # | # | in (nca.ecology.ipcc:Boreal, nca.ecology.ipcc:SubPolar, nca.ecology.ipcc:ColdTemperate) | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | # | # | in (im:High, im:VeryHigh) | # | # | in (ecology:Nanophyll, ecology:Microphyll) | in (im:ModeratelyHigh, im:High) | in (im:None, im:Low) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Same hard branch with LAI, leaf size and fire evidence relaxed.
  # | # | # | in (nca.ecology.ipcc:Boreal, nca.ecology.ipcc:SubPolar, nca.ecology.ipcc:ColdTemperate) | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | # | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | # | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Boreal/subpolar woody peat bog, fully supported.
  # | # | # | in (nca.ecology.ipcc:Boreal, nca.ecology.ipcc:SubPolar, nca.ecology.ipcc:ColdTemperate) | in (ecology:Humid, ecology:Wet) | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | in (im:VeryLow, im:Low) | # | in (im:High, im:VeryHigh) | # | # | in (ecology:Nanophyll, ecology:Microphyll) | in (im:ModeratelyHigh, im:High) | in (im:None, im:Low) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Same woody hard branch with soft evidence relaxed.
  # | # | # | in (nca.ecology.ipcc:Boreal, nca.ecology.ipcc:SubPolar, nca.ecology.ipcc:ColdTemperate) | in (ecology:Humid, ecology:Wet) | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | in (im:VeryLow, im:Low) | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | # | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Tropical high-elevation non-woody peat bog, fully supported.
  # | # | in (earth:Alpine, earth:Montane, earth:Subalpine) | nca.ecology.ipcc:Tropical | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | # | # | in (im:High, im:VeryHigh) | # | # | in (ecology:Nanophyll, ecology:Microphyll) | in (im:ModeratelyHigh, im:High) | in (im:None, im:Low) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Tropical high-elevation non-woody hard fallback.
  # | # | in (earth:Alpine, earth:Montane, earth:Subalpine) | nca.ecology.ipcc:Tropical | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | # | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | # | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Tropical high-elevation woody peat bog, fully supported.
  # | # | in (earth:Alpine, earth:Montane, earth:Subalpine) | nca.ecology.ipcc:Tropical | in (ecology:Humid, ecology:Wet) | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | in (im:VeryLow, im:Low) | # | in (im:High, im:VeryHigh) | # | # | in (ecology:Nanophyll, ecology:Microphyll) | in (im:ModeratelyHigh, im:High) | in (im:None, im:Low) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // Tropical high-elevation woody hard fallback.
  # | # | in (earth:Alpine, earth:Montane, earth:Subalpine) | nca.ecology.ipcc:Tropical | in (ecology:Humid, ecology:Wet) | in (landcover:Forest, landcover:Shrubland) | # | hydrology:Ombrotrophic | im:Low | in (chemistry:Acidic, chemistry:HighlyAcidic) | # | in (im:Low, im:Moderate) | # | in (im:VeryLow, im:Low) | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | # | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateMontanePeatBog ,

  // TF1.7 — Temperate/boreal fen, fully supported.
  # | hydrology:Permanent | in (earth:Lowland, earth:Montane, earth:Alpine, earth:Subalpine) | in (nca.ecology.ipcc:Boreal, nca.ecology.ipcc:SubPolar, nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate) | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Minerotrophic | in (im:Moderate, im:High) | in (chemistry:Acidic, chemistry:Neutral, chemistry:Alkaline, chemistry:HighlyAlkaline) | # | in (im:Moderate, im:High) | # | # | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | in (im:Low, im:Moderate, im:High) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateFen ,

  // Temperate/boreal fen with NPP, base saturation and permanence relaxed.
  # | # | in (earth:Lowland, earth:Montane, earth:Alpine, earth:Subalpine) | in (nca.ecology.ipcc:Boreal, nca.ecology.ipcc:SubPolar, nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate) | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Minerotrophic | # | in (chemistry:Acidic, chemistry:Neutral, chemistry:Alkaline, chemistry:HighlyAlkaline) | # | # | # | # | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | in (im:Low, im:Moderate, im:High) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateFen ,

  // Tropical/subtropical high-elevation fen: climate/elevation are lower-weight support.
  # | hydrology:Permanent | in (earth:Montane, earth:Alpine, earth:Subalpine) | in (nca.ecology.ipcc:SubTropical, nca.ecology.ipcc:Tropical) | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Minerotrophic | in (im:Moderate, im:High) | in (chemistry:Acidic, chemistry:Neutral, chemistry:Alkaline, chemistry:HighlyAlkaline) | # | in (im:Moderate, im:High) | # | # | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | in (im:Low, im:Moderate, im:High) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateFen ,

  // TF1.7 hard-core fallback; all weight-below-1 evidence is relaxed.
  # | # | # | # | in (ecology:Humid, ecology:Wet) | in (landcover:Grassland, landcover:LichenMoss, landcover:Wetland) | # | hydrology:Minerotrophic | # | in (chemistry:Acidic, chemistry:Neutral, chemistry:Alkaline, chemistry:HighlyAlkaline) | # | # | # | # | # | # | # | # | # | in (im:ModeratelyHigh, im:High) | in (im:Low, im:Moderate, im:High) | # | in (im:Moderate, im:High) | nca.ecosystem.iucn:BorealTemperateFen ,

  // TF1.2 — Humid/subhumid floodplain forested wetland.
  # | # | in (earth:Lowland, earth:Montane) | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical) | in (ecology:Humid, ecology:SubHumid) | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | true | # | # | in (im:Low, im:Moderate, im:High) | in (ecology:Open, ecology:Dense) | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

  // TF1.2 humid/subhumid permanent-watercourse branch.
  hydrology:Watercourse | hydrology:Permanent | in (earth:Lowland, earth:Montane) | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical) | in (ecology:Humid, ecology:SubHumid) | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | in (ecology:Open, ecology:Dense) | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

  // TF1.2 humid/subhumid base-saturation-supported branch (base is weight 0.9).
