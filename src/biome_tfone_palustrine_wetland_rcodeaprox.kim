  // TF1.2 arid/semi-arid permanent-watercourse support.
  hydrology:Watercourse | hydrology:Permanent | in (earth:Lowland, earth:Montane) | in (nca.ecology.ipcc:ColdTemperate, nca.ecology.ipcc:WarmTemperate, nca.ecology.ipcc:SubTropical) | in (ecology:Arid, ecology:SemiArid) | in (landcover:Forest, landcover:Shrubland) | # | # | # | # | # | # | # | in (im:Low, im:Moderate, im:High) | in (ecology:Open, ecology:Dense) | # | # | # | # | # | # | # | # | nca.ecosystem.iucn:SubtropicalWarmTemperateForestedWetland ,

  // TF1.2 arid/semi-arid base-saturation support.
