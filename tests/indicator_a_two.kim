worldview im
using (ECOSYSTEM_NATURALNESS) from esa.aries.ecosystem.naturalness;

@test(
    name = "indicator_a_two",
    description  = "",
    // add to the list any concepts to be observed in the context below
    observations = (
    "primitive_characteristic.small_areas_for_testing.rule_based_external"
    "esa.aries.ecosystem.naturalness.natural_ecosystem_extent"
    "im|esa.aries.sandbox/tests/indicator_a_two.natural_ecosystem_extent_using_ecosystem_naturalness_table"
    "esa.aries.ecosystem.naturalness.natural_ecosystem_extent_iucn_get_static"
//    "esa.aries.ecosystem.naturalness.natural_ecosystem_extent_iucn_get_dynamic"
    ),
    // add assertions to check the observations after execution
    assertions = ()
)
// change the concept to the one you want; use a URN optionally (in a separate test project including the resource)
observe /* a:urn:to:use#objectid as */ earth:Region named indicator_a_two
	over space(
		urn='local:rubencc:esa.aries.sandbox:esa_weed_czechrepublic_rb_testing_polygons#fid_id=1',
		grid="30 m"),
	time(start=2021, end=2022, step=1.year);

//TODO: some values are missing in the ECOSYSTEM_NATURALNESS table for some EFGs, don't use this model for IUCN GET
model im:Possible nca.ecosystem.naturalness:NaturalnessLevel named natural_ecosystem_extent_using_ecosystem_naturalness_table 	
observing
	nca.ecosystem.iucn:EcosystemType named iucn
	lookup (* , iucn , ? )
	into ECOSYSTEM_NATURALNESS;