worldview im;

@test(
    name = "cameroon_launch_contexts",
    description  = "",
    // add to the list any concepts to be observed in the context below
    observations = (
    "esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_rule_based"
    "esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_machine_learning"),
    // add assertions to check the observations after execution
    assertions = ()
)
// change the concept to the one you want; use a URN optionally (in a separate test project including the resource)
observe /* a:urn:to:use#objectid as */ earth:Region named cameroon_launch_contexts
    over space (urn = "local:alessio.bulckaen:esa.aries.sandbox:esa_weed_cameroon_validation_pa_20km_epsg32633#site_id=4",
    			grid="30 m",
                projection= "EPSG:32633"),
        time(start=2024, end=2025, step=1.year);

