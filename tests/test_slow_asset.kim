worldview im;

@test(
    name = "test_slow_asset",
    description  = "",
    // add to the list any concepts to be observed in the context below
    observations = (
    "primitive_characteristic.vegetation.vegetation_leaf_area_index"
	"primitive_characteristic.vegetation.specific_leaf_area_input"
	"primitive_characteristic.anthropogenic.managed_waters_aquaculture"
    ),
    // add assertions to check the observations after execution
    assertions = ()
)
// change the concept to the one you want; use a URN optionally (in a separate test project including the resource)
observe /* a:urn:to:use#objectid as */ earth:Region named test_slow_asset
    over space(
    		urn='local:rubencc:esa.aries.sandbox:esa_weed_colombia_rb_testing_polygons#fid_id=1',
    		grid="30 m"),
    time(year=2021);

