worldview im;

@test(
    name = "comparison_model",
    description  = "",
    // add to the list any concepts to be observed in the context below
    observations = (
    "esa.aries.ecosystem.reference.global_validation_points"
    "esa.aries.ecosystem_extent.ecosystem_type_iucn_get_level3_rule_based"
    "esa.aries.rule_based_accuracy.reference-type-of-ecosystem-resolver"
