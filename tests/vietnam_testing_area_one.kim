worldview im;

@test(
    name = "vietnam_testing_area_1",
    description  = "",
    // add to the list any concepts to be observed in the context below
    observations = (
    "beta.ecosystem_type.ecosystem_type_iucn_get_level3_rule_based"
    ),
    // add assertions to check the observations after execution
    assertions = ()
)
// change the concept to the one you want; use a URN optionally (in a separate test project including the resource)
observe /* a:urn:to:use#objectid as */ earth:Region named vietnam_testing_area_1
    over space(
        urn='local:rubencc:esa.aries.sandbox:esa_weed_vietnam_rb_testing_polygons#fid_id=1',
        grid="30 m"),
    time(year=2021);
