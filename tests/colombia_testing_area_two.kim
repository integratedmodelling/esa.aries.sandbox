observe earth:Region named colombia_testing_area_2_region
    over space(
        urn='local:rubencc:esa.aries.sandbox:esa_weed_colombia_rb_testing_polygons#fid_id=2',
        grid="30 m"),
    time(year=2021);

@colormap(values = {
    true:   (0 255 0)
    false:  (255 0 0)
})
model presence of (earth:Region with type of nca.ecosystem.iucn:Ecosystem) named matching_ecosystem_type
    observing
        alphathree:RuleBased nca.ecosystem.iucn:PalustrineWetland type of nca.ecosystem.iucn:Ecosystem named biome_tf1_palustrine_wetland_soft_rules,
        alphathree:RuleBasedExternal nca.ecosystem.iucn:EcosystemType named rule_based_external
    lookup (biome_tf1_palustrine_wetland_soft_rules, rule_based_external, ?) 
        into IUCN_GET_LEVEL_CONSISTENCY_TABLE;

define table ecosystem_type_result_comparison_by_ecosystem_type_modelled_vs_reference as {
	title: "Comparison of the ecosystem type result between modelled & reference maps by ES types"
	label: "Areas of difference between modelled & reference maps by ES types"
	target: alphathree:RuleBasedExternal nca.ecosystem.iucn:EcosystemType
	columns:({ title: "{classifier}", filter: alphathree:RuleBasedExternal nca.ecosystem.iucn:EcosystemType}), 	
	rows:   ({ title: "Consistency in (km²) between modelled & reference maps ({classifier})", target: im:Area in km^2, filter: presence of (earth:Region with type of nca.ecosystem.iucn:Ecosystem) }
	         { title: "Total area (km²) according to reference map", summarize: [r1 + r2], style: bold }
	         { title: "Similarity of the result from the modelled & reference maps (%)", summarize: [(r1 / (r1 + r2)) * 100], style: bold }
	        )
	};